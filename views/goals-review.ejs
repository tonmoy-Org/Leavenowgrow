<!DOCTYPE html>
<html lang="en">
  <head id="applicantStyles">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>Goals Worksheets</title>

    <link href="/css/app.css" rel="stylesheet" />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />

    <style>
      .rounded-button {
        width: 40px;
        height: 40px;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
      }

      .check-all {
        display: flex;
        left: 0;
        justify-content: flex-end;
        top: 0;
        height: 2rem;
        width: 100%;
        align-items: flex-start;
      }

      .check-all > label {
        font-size: 0.6rem;
        margin-left: 0.3rem;
      }

      .downloadOptions ul li {
        cursor: pointer;
      }

      .downloadOptions ul li:hover {
        color: #dc3545;
      }

      .table-responsive {
        height: calc(100vh - 200px);
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <nav id="sidebar" class="sidebar js-sidebar">
        <div class="sidebar-content js-simplebar">
          <%- include('partials/navbar', { user: user, path: "companies" }); %>
        </div>
      </nav>

      <div class="main">
        <%- include('partials/header', { user: user }); %>

        <main class="content" style="margin-top: 1px; padding-top: 10px">
          <div class="container-fluid p-0">
            <div class="row py-2">
              <div class="col-6">
                <h1 class="h3 mb-3">Goals Worksheets</h1>
              </div>
              <div class="col-6" style="position: relative">
                <div class="float-end d-flex align-items-center gap-2">
                  <% if(user) { %> <% if((user.role == 2 || user.role == 1) &&
                  comp) { %>
                  <a
                    href="/goals-worksheet/<%= company %>"
                    target="_blank"
                    class="btn btn-dark btn-lg rounded-button"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="New Goals Worksheet"
                    role="button"
                  >
                    <i class="align-middle" data-feather="link-2"></i>
                  </a>
                  <% } %> <% if(!comp) { %>
                  <a
                    href="/group-goals-worksheet/<%= company %>"
                    target="_blank"
                    class="btn btn-primary btn-lg rounded-button"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="New Goals Worksheet"
                    role="button"
                    ><i class="align-middle" data-feather="link-2"></i
                  ></a>
                  <% } %> <% } %>

                  <button
                    class="btn btn-secondary btn-lg rounded-button"
                    id="downloadButton"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="Download"
                  >
                    <i class="align-middle" data-feather="download"></i>
                  </button>
                  <div
                    class="downloadOptions"
                    id="downloadOptions"
                    style="
                      z-index: 10;
                      position: absolute;
                      top: 40px;
                      right: 10px;
                      width: 100px;
                      display: none;
                      background-color: #495057;
                      color: #ffffff;
                      border: 1px solid gray;
                    "
                  >
                    <ul style="list-style-type: none; padding: 8px">
                      <li
                        style="padding: 4px; font-weight: 700"
                        onclick="downloadFile('docx')"
                      >
                        DOCX
                      </li>
                      <li
                        style="padding: 4px; font-weight: 700"
                        onclick="downloadFile('excel')"
                      >
                        EXCEL
                      </li>
                      <li
                        style="padding: 4px; font-weight: 700"
                        onclick="downloadFile('pdf')"
                      >
                        PDF
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-12 col-lg-12 col-xxl-12 d-flex">
                <div class="card flex-fill">
                  <div style="text-align: center; padding: 20px">
                    <h3 style="font-weight: bold; line-height: 13px">
                      <span style="font-size: 10px">Goals Worksheet</span
                      ><br /><span style="font-size: 14px">
                        <%= goalsWorksheets?.companyName %>
                      </span>
                    </h3>
                  </div>
                  <% if(goalsWorksheets?.length==0) { %>
                  <div
                    class="col-md-4 text-center"
                    style="
                      margin: auto;
                      background-color: #cfe2ff;
                      border-radius: 5px;
                      padding: 15px 0 0 0;
                    "
                  >
                    <p>No Worksheets Found.</p>
                  </div>
                  <br />

                  <% } else { %>

                  <div class="table-responsive">
                    <table
                      id="sortableTable"
                      class="table table-hover my-0 fs-5"
                      style="table-layout: fixed"
                    >
                      <thead style="display: table-header-group">
                        <tr>
                          <th
                            class="first-column"
                            style="
                              border: 2px solid #000;
                              position: relative;
                              width: 128px;
                            "
                          >
                            <div class="check-all">
                              <label>Select All</label>
                              <input
                                type="checkbox"
                                id="selectAllCheckbox"
                                style="float: right"
                              />
                            </div>
                            Actions
                          </th>

                          <% goalsWorksheets.forEach(function(item, index) { %>
                          <th
                            id="<%= index + 1 %>"
                            draggable="true"
                            ondragstart="drag(event)"
                            style="border: 2px solid #000; width: 240px"
                          >
                            <input
                              type="checkbox"
                              class="header-checkbox"
                              data-column="<%= item._id %>"
                              style="float: right"
                            />
                            <br />
                            <div class="d-flex align-items-center gap-2">
                              <!-- TODO  -->
                              <a
                                href="/edit-goals-worksheet-form/<%= item._id %>"
                                class="btn btn-primary rounded-button"
                                role="button"
                                ><i class="align-middle" data-feather="edit"></i
                              ></a>

                              <button
                                type="button"
                                class="btn btn-danger rounded-button"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal<%= item._id %>"
                              >
                                <i
                                  class="align-middle"
                                  data-feather="trash"
                                ></i>
                              </button>

                              <button
                                style="position: relative"
                                id="downloadSingle<%= index+1 %>"
                                onclick="openOptions('<%= index+1 %>')"
                                class="btn btn-secondary rounded-button"
                              >
                                <i
                                  class="align-middle"
                                  data-feather="download"
                                ></i>
                                <div
                                  class="downloadOptions"
                                  id="downloadSingleOptions<%= index+1 %>"
                                  style="
                                    z-index: 10;
                                    position: absolute;
                                    top: 40px;
                                    right: 10px;
                                    width: 100px;
                                    display: none;
                                    background-color: #495057;
                                    color: #ffffff;
                                    border: 1px solid gray;
                                  "
                                >
                                  <ul
                                    style="list-style-type: none; padding: 8px"
                                  >
                                    <li
                                      style="padding: 4px; font-weight: 700"
                                      onclick="downloadSingleEmployeeFile('docx', '<%= item._id %>')"
                                    >
                                      DOCX
                                    </li>
                                    <li
                                      style="padding: 4px; font-weight: 700"
                                      onclick="downloadSingleEmployeeFile('excel', '<%= item._id %>')"
                                    >
                                      EXCEL
                                    </li>
                                    <li
                                      style="padding: 4px; font-weight: 700"
                                      onclick="downloadSingleEmployeeFile('pdf', '<%= item._id %>')"
                                    >
                                      PDF
                                    </li>
                                  </ul>
                                </div>
                              </button>

                              <!-- <a
                                href="/edit-form/<%= item?.formDataId %>"
                                class="btn btn-success rounded-button"
                                role="button"
                                title="AOA of employee"
                              >
                                <i class="align-middle" data-feather="eye"></i>
                              </a> -->
                            </div>
                          </th>

                          <!-- Confirm delete modal-->
                          <div
                            class="modal fade"
                            id="confirmDeleteModal<%= item._id %>"
                            tabindex="-1"
                            aria-labelledby="exampleModalLabel"
                            aria-hidden="true"
                          >
                            <div class="modal-dialog">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h5
                                    class="modal-title"
                                    id="exampleModalLabel"
                                  >
                                    Confirm Delete
                                  </h5>
                                  <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                  ></button>
                                </div>
                                <div class="modal-body">
                                  <h6>
                                    Are you sure you want to delete <%=
                                    item?.name %>
                                  </h6>
                                </div>

                                <div class="modal-footer">
                                  <a
                                    href="/delete-goals-worksheet/<%= item._id %>"
                                    type="submit"
                                    class="btn btn-danger"
                                    >Delete
                                  </a>
                                </div>
                              </div>
                            </div>
                          </div>

                          <% }); %>
                        </tr>

                        <tr>
                          <th
                            class="first-column"
                            style="
                              background-color: #ccffff;
                              border: 2px solid #000;
                            "
                          >
                            Name
                          </th>
                          <% goalsWorksheets.forEach(function(item, index) { %>
                          <th
                            id="<%= index + 1 %>"
                            ondragstart="drag(event)"
                            data-id="<%= item?.name %>"
                            style="
                              font-weight: bold;
                              background-color: #ccffff;
                              border: 2px solid #000;
                            "
                          >
                            <%= item?.name %>
                          </th>
                          <% }); %>
                        </tr>
