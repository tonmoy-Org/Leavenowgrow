  <script>
    let currentLogs = [];
    let secondsAgo = 0;

    function renderLogs(logs) {
      const tbody = document.getElementById("logTableBody");
      tbody.innerHTML = "";

      let operationalTotal = 0;
      let degradedTotal = 0;

      logs.forEach(item => {
        const tr = document.createElement("tr");
        const isSuccess = item.status === "success";

        if (isSuccess) operationalTotal++;
        else degradedTotal++;

        tr.innerHTML = `
          <td class="text-start">
            <div class="d-flex align-items-center">
              <span class="status-pulse ${isSuccess ? 'online' : 'offline'} me-2"></span>
              <div>
                <span class="fw-semibold text-dark d-block">${item.name}</span>
                <span class="text-muted small">${item.description || ''}</span>
              </div>
            </div>
          </td>
          <td class="text-center">
            <span class="badge bg-light text-dark border px-2 py-1">${item.type || 'System Module'}</span>
          </td>
          <td class="text-center">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">
              ${item.metric || (item.totalRuns + ' records')}
            </span>
          </td>
          <td class="text-center text-muted fw-medium">${item.timeAgo || 'Live'}</td>
          <td class="text-end">
            <span class="badge ${isSuccess ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} px-3 py-1">
              ${isSuccess ? '✓ Operational' : '⚠ Degraded'}
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });

      const successBadge = document.getElementById("stat-success");
      const errorBadge = document.getElementById("stat-error");
      const partialBadge = document.getElementById("stat-partial");

      if (successBadge) successBadge.innerText = `${operationalTotal} Operational Services`;
      if (errorBadge) errorBadge.innerText = `${degradedTotal} Attention Required`;
      if (partialBadge) partialBadge.innerText = `${logs.length} Total Components`;
    }

    function filterLogs() {
      const searchInput = document.getElementById("searchInput");
      const statusFilter = document.getElementById("statusFilter");
      const search = searchInput ? searchInput.value.toLowerCase() : "";
      const status = statusFilter ? statusFilter.value : "all";

      const filtered = currentLogs.filter(item => {
        const matchesSearch = item.name.toLowerCase().includes(search) || (item.description && item.description.toLowerCase().includes(search));
        const matchesStatus = (status === "all") || (item.status === status);
        return matchesSearch && matchesStatus;
      });

      renderLogs(filtered);
    }

    function switchTab(tabId, btn) {
      document.querySelectorAll('.nav-link').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content-panel').forEach(c => c.style.display = 'none');

      btn.classList.add('active');
      const targetPanel = document.getElementById(tabId);
      if (targetPanel) targetPanel.style.display = 'block';
    }

    function generateBars(containerId) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = "";
      for (let i = 0; i < 90; i++) {
        const bar = document.createElement("div");
        const isDown = false;
        bar.className = "uptime-bar-tick" + (isDown ? " down" : "");
        bar.title = `Day ${i + 1}: 100% Operational`;
        container.appendChild(bar);
      }
    }

    function fetchLiveStatus() {
      secondsAgo = 0;
      const cardUpdated = document.getElementById("card-updated-time");
      const heroUpdated = document.getElementById("hero-updated-time");
      if (cardUpdated) cardUpdated.innerText = "Auto-synced";
      if (heroUpdated) heroUpdated.innerHTML = `<i class="far fa-clock me-1"></i> Refreshed just now`;

      fetch('/api/status-data')
        .then(res => res.json())
        .then(data => {
          const isOperational = data.status === "OPERATIONAL";
          const globalBadge = document.getElementById("global-badge");
          const heroCard = document.getElementById("hero-card");
          const heroTitle = document.getElementById("hero-title");

          if (globalBadge) {
            if (isOperational) {
              globalBadge.className = "badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold";
              globalBadge.innerHTML = `<span class="status-pulse online"></span> All Systems Operational`;
            } else {
              globalBadge.className = "badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-semibold";
              globalBadge.innerHTML = `<span class="status-pulse offline"></span> System Failures Detected`;
            }
          }

          if (heroCard) {
            heroCard.className = `hero-banner-card mb-4 ${isOperational ? '' : 'offline'}`;
          }

          if (heroTitle) {
            if (isOperational) {
              heroTitle.innerHTML = `<span class="status-pulse online"></span> All Leave Now Grow Services Are Operational`;
            } else {
              heroTitle.innerHTML = `<span class="status-pulse offline"></span> Action Required: System Failures / Degradation Detected`;
            }
          }

          if (data.uptimeString) {
            const uptimeText = document.getElementById("process-uptime-text");
            const memoryText = document.getElementById("process-memory-text");
            if (uptimeText) uptimeText.innerText = "100% Active";
            if (memoryText) memoryText.innerText = `Heap: ${data.memoryUsageMB}MB • Active ${data.uptimeString}`;
          }

          if (data.database) {
            const isConnected = data.database === "Connected" && !data.dbPingError;
            const dbText = document.getElementById("db-status-text");
            const dbSub = document.getElementById("db-sub-text");
            const dbPill = document.getElementById("db-uptime-pill");
            if (dbText) {
              dbText.innerText = isConnected ? "Connected" : "Disconnected";
              dbText.className = isConnected ? "fw-bold text-success mb-0 mt-1" : "fw-bold text-danger mb-0 mt-1";
            }
            if (dbSub) dbSub.innerText = isConnected ? `Primary Cluster (${data.dbLatencyMs || 0}ms Ping)` : "Connection Attention Required";
            if (dbPill) {
              dbPill.innerText = isConnected ? "100.0% Operational" : "Database Attention";
              dbPill.className = isConnected ? "badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-semibold" : "badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 fw-semibold";
            }
          }

          if (data.dbStats) {
            const sysRate = document.getElementById("system-services-rate");
            const sysSub = document.getElementById("system-services-sub");
            const totalRecs = (data.dbStats.formData || 0) + (data.dbStats.selfEvaluations || 0) + (data.dbStats.managerEvaluations || 0) + (data.dbStats.goalsWorksheets || 0) + (data.dbStats.users || 0);
            if (sysRate) {
              sysRate.innerText = isOperational ? "Operational" : "Degraded";
              sysRate.className = isOperational ? "fw-bold text-dark mb-0 mt-1" : "fw-bold text-danger mb-0 mt-1";
            }
            if (sysSub) sysSub.innerText = `${totalRecs} Records in MongoDB`;
          }

          if (data.automationLogs && data.automationLogs.length > 0) {
            currentLogs = data.automationLogs;
            filterLogs();
          }
        })
        .catch(err => console.error("Error fetching live status:", err));
    }

    // Initialize Page
    generateBars("bars-server");
    generateBars("bars-db");
    generateBars("bars-scrapers");
    fetchLiveStatus();

    // Auto Refresh Polling
    setInterval(() => {
      secondsAgo++;
      const heroUpdated = document.getElementById("hero-updated-time");
      if (heroUpdated) heroUpdated.innerHTML = `<i class="far fa-clock me-1"></i> Refreshed ${secondsAgo}s ago`;
    }, 1000);

    // Live sync polling every 10 seconds
    setInterval(fetchLiveStatus, 10000);
  </script>
</body>
</html>
