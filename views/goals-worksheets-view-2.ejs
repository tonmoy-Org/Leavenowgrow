<!DOCTYPE html>
<html lang="en">
  <head id="applicantStyles">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>Goals Worksheets</title>

    <link href="/css/app.css" rel="stylesheet" />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />

    <style>
      .rounded-button {
        width: 40px;
        height: 40px;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
      }

      .check-all {
        display: flex;
        left: 0;
        justify-content: flex-end;
        top: 0;
        height: 2rem;
        width: 100%;
        align-items: flex-start;
      }

      .check-all > label {
        font-size: 0.6rem;
        margin-left: 0.3rem;
      }

      .downloadOptions ul li {
        cursor: pointer;
      }

      .downloadOptions ul li:hover {
        color: #dc3545;
      }

      .table-responsive {
        height: calc(100vh - 200px);
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <nav id="sidebar" class="sidebar js-sidebar">
        <div class="sidebar-content js-simplebar">
          <%- include('partials/navbar', { user: user, path: "companies" }); %>
        </div>
      </nav>

      <div class="main">
        <%- include('partials/header', { user: user }); %>

        <main class="content" style="margin-top: 1px; padding-top: 10px">
          <div class="container-fluid p-0">
            <div class="row py-2">
              <div class="col-6">
                <h1 class="h3 mb-3">Goals Worksheets</h1>
              </div>
              <div class="col-6" style="position: relative">
                <div class="float-end d-flex align-items-center gap-2">
                  <% if(goalsWorksheet) { %>
                  <button
                    class="btn btn-secondary btn-lg rounded-button"
                    id="downloadButton"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="Download"
                  >
                    <i class="align-middle" data-feather="download"></i>
                  </button>
                  <div
                    class="downloadOptions"
                    id="downloadOptions"
                    style="
                      z-index: 10;
                      position: absolute;
                      top: 40px;
                      right: 10px;
                      width: 100px;
                      display: none;
                      background-color: #495057;
                      color: #ffffff;
                      border-radius: 8px;
                    "
                  >
                    <ul style="list-style-type: none; padding: 8px">
                      <li
                        style="padding: 4px; font-weight: 700"
                        onclick="downloadSingleEmployeeFile('docx', '<%= goalsWorksheet?._id %>')"
                      >
                        DOCX
                      </li>
                      <li
                        style="padding: 4px; font-weight: 700"
                        onclick="downloadSingleEmployeeFile('pdf', '<%= goalsWorksheet?._id %>')"
                      >
                        PDF
                      </li>
                      <li
                        style="padding: 4px; font-weight: 700"
                        onclick="downloadSingleEmployeeFile('excel', '<%= goalsWorksheet?._id %>')"
                      >
                        EXCEL
                      </li>
                    </ul>
                  </div>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-12 col-lg-12 col-xxl-12 d-flex">
                <div class="card flex-fill">
                  <form
                    onsubmit="handleSubmit(event)"
                    class="row align-items-end p-4"
                  >
                    <div class="col mb-3">
                      <label for="year" class="form-label">Quarter</label>
                      <select
                        class="form-select"
                        id="quarter"
                        name="quarter"
                        required
                      >
                        <option selected disabled>Choose quarter</option>
                        <option value="Q1">Q1 (January - March)</option>
                        <option value="Q2">Q2 (April - June)</option>
                        <option value="Q3">Q3 (July - September)</option>
                        <option value="Q4">Q4 (October - December)</option>
                      </select>
                      <div class="invalid-feedback">
                        Please select a valid quarter.
                      </div>
                    </div>
                    <div class="col mb-3">
                      <label for="year" class="form-label">Year</label>
                      <input
                        type="text"
                        value="<%= goalsWorksheet?.year %>"
                        class="form-control"
                        id="year"
                        name="year"
                        aria-describedby="yearHelp"
                        pattern="(?:(?:18|19|20|21)[0-9]{2})"
                        placeholder="2025"
                        required
                      />
                    </div>
                    <div class="col mb-3">
                      <button type="submit" class="btn btn-primary">
                        <i class="align-middle" data-feather="search"></i>
                      </button>
                    </div>
                  </form>

                  <div style="text-align: center; padding: 8px">
                    <p style="margin-bottom: 6px; font-size: 18px">
                      <%= companyName %>
                    </p>
                    <p style="margin-bottom: 6px; font-size: 16px">
                      <%= goalsWorksheet?.name %>
                    </p>
                    <p style="margin-bottom: 6px; font-size: 14px">
                      <%= goalsWorksheet?.quarter %>, <%= goalsWorksheet?.year
                      %>
                    </p>
                  </div>

                  <% if(goalsWorksheet) { %>
                  <div class="table-responsive">
                    <table
                      id="sortableTable"
                      class="table table-hover my-0 fs-5"
                      style="table-layout: fixed"
                    >
                      <thead style="display: table-header-group">
                        <tr>
                          <th
                            class="first-column"
                            style="
                              border: 2px solid #000;
                              position: relative;
                              width: 40px;
                              background-color: #ccffff;
                            "
                          >
                            #
                          </th>

                          <th
                            style="
                              border: 2px solid #000;
                              width: 240px;
                              background-color: #ccffff;
                            "
                          >
                            Goals
                          </th>
                          <th
                            style="
                              border: 2px solid #000;
                              width: 240px;
                              background-color: #ccffff;
                            "
                          >
                            Benefits
                          </th>
                          <th
                            style="
                              border: 2px solid #000;
                              width: 240px;
                              background-color: #ccffff;
                            "
                          >
                            Metrics
                          </th>
                          <th
                            style="
                              border: 2px solid #000;
                              width: 240px;
                              background-color: #ccffff;
                            "
                          >
                            Actions
                          </th>
                        </tr>
                      </thead>
                      <tbody
                        id="applicantInfo"
                        style="display: table-row-group"
                      >
                        <% goalsWorksheet?.worksheets?.forEach(function(sheet,
                        index) { %> <% const goalItems =
                        sheet?.goal?.replace(/\t/g,
                        "")?.split('\r\n')?.map(subItem => subItem?.length > 0 ?
                        `
                        <li style="margin-bottom: 10px">${subItem}</li>
                        ` : "" ) .join(''); %> <% const benefitItems =
                        sheet?.benefit?.replace(/\t/g,
                        "")?.split('\r\n')?.map(subItem => subItem?.length > 0 ?
                        `
                        <li style="margin-bottom: 10px">${subItem}</li>
                        ` : "" ) .join(''); %> <% const metricItems =
                        sheet?.metric?.replace(/\t/g,
                        "")?.split('\r\n')?.map(subItem => subItem?.length > 0 ?
                        `
                        <li style="margin-bottom: 10px">${subItem}</li>
                        ` : "" ) .join(''); %> <% const actionItems =
                        sheet?.action.replace(/\t/g,
                        "")?.split('\r\n')?.map(subItem => subItem?.length > 0 ?
                        `
                        <li style="margin-bottom: 10px">${subItem}</li>
                        ` : "" ) .join(''); %>

                        <tr>
                          <td style="border: 2px solid #000"><%= index+1 %></td>
                          <td style="border: 2px solid #000">
                            <%- `
                            <ul style="padding: 0px; list-style-type: none">
                              ${goalItems}
                            </ul>
                            ` %>
                          </td>
                          <td style="border: 2px solid #000">
                            <%- `
                            <ul style="padding: 0px; list-style-type: none">
                              ${benefitItems}
                            </ul>
                            ` %>
                          </td>
                          <td style="border: 2px solid #000">
                            <%- `
                            <ul style="padding: 0px; list-style-type: none">
                              ${metricItems}
                            </ul>
                            ` %>
                          </td>
                          <td style="border: 2px solid #000">
                            <%- `
                            <ul style="padding: 0px; list-style-type: none">
                              ${actionItems}
                            </ul>
                            ` %>
                          </td>
                        </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <% } else { %>
                  <div class="d-flex align-items-center justify-content-center">
                    <p class="fw-semibold">No data found.</p>
                  </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </main>

        <footer class="footer"><%- include('partials/footer'); %></footer>
      </div>
    </div>

    <script src="/js/app.js"></script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const quarter = "<%= goalsWorksheet?.quarter %>";
        const quarterElem = document.getElementById("quarter");

        for (let i = 0; i < quarterElem.options.length; i++) {
          if (quarterElem.options[i].value === quarter) {
            quarterElem.options[i].selected = true;
          }
        }
      });
    </script>

    <script>
      function handleSubmit(event) {
        event.preventDefault();
        const form = event.target;

        const data = {
          quarter: form.quarter.value,
          year: form.year.value,
        };

        const currentHref = new URL(document.location.href);

        currentHref.searchParams.set("qt", data?.quarter);
        currentHref.searchParams.set("yr", data?.year);

        window.location.href = currentHref.toString();
      }
    </script>

    <script>
      // Function to handle the select-all checkbox
      function handleSelectAll() {
        const selectAllCheckbox = document.getElementById("selectAllCheckbox");
        const headerCheckboxes = document.querySelectorAll(".header-checkbox");

        for (const checkbox of headerCheckboxes) {
          checkbox.checked = selectAllCheckbox.checked;
        }
      }

      document.addEventListener("DOMContentLoaded", function () {
        // Add a change event listener to the select-all checkbox
        const selectAllCheckbox = document.getElementById("selectAllCheckbox");
        selectAllCheckbox.addEventListener("change", handleSelectAll);
      });

      document.addEventListener("DOMContentLoaded", function () {
        // Add an event listener to the form submit button
        const createGroupBtn = document.getElementById("create_group_btn");
        createGroupBtn.addEventListener("click", submitForm);
      });

      function submitForm() {
        // Gather checked values of header checkboxes
        const headerCheckboxes = document.querySelectorAll(
          ".header-checkbox:checked"
        );
        const headerValues = Array.from(headerCheckboxes).map(
          (checkbox) => checkbox.dataset.column
        );

        // Append the checked values to the form as a hidden input
        const form = document.getElementById("createGroupForm");
        const hiddenInput = document.createElement("input");
        hiddenInput.type = "hidden";
        hiddenInput.name = "selectedIds"; // You can change the name as needed
        hiddenInput.value = JSON.stringify(headerValues); // Convert to JSON to send as an array
        form.appendChild(hiddenInput);

        // Submit the form
        form.submit();
      }
    </script>

    <script>
      var dragCol = null;

      function handleDragStart(e) {
        dragCol = this;
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData("text/html", this.outerHTML);
      }

      function handleDragOver(e) {
        if (e.preventDefault) {
          e.preventDefault();
        }
        e.dataTransfer.dropEffect = "move";
        return false;
      }
      const updateColumn = async (id, columnOrder) => {
        try {
          const url = `/update-columnOrder/${id}`;
          const response = await fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ columnOrder }),
          });

          if (response.ok) {
            const responseData = await response.json();
            console.log(new Data(), responseData); // Success message
          } else {
            console.error(
              new Data(),
              "Failed to update column:",
              response.status,
              response.statusText
            );
          }
        } catch (error) {
          console.error(new Date(), "An error occurred:", error.message);
        }
      };

      const fetchColumnOrder = async (id) => {
        try {
          const response = await fetch(`/get-ColumnOrder/${id}`);
          const data = await response.json();

          if (response.status === 200) {
            return data; // Return the data if the request is successful
          } else {
            console.error("Failed to fetch column order:", response.status);
            return null; // Return null in case of an error
          }
        } catch (error) {
          console.error("An error occurred:", error.message);
          return null; // Return null in case of an error
        }
      };

      async function handleDrop(e) {
        if (e.preventDefault) {
          e.preventDefault();
        }
        if (dragCol === this) {
          return false;
        }

        var sourceIndex = Array.from(dragCol.parentNode.children).indexOf(
          dragCol
        );
        var targetIndex = Array.from(this.parentNode.children).indexOf(this);
        var table = document.getElementById("sortableTable");
        var rows = table.rows;

        // Create an array to store the new order of column indexes and IDs
        var newOrder = [];
        var newIDs = [];

        for (var i = 0; i < rows.length; i++) {
          var sourceCell = rows[i].cells[sourceIndex];
          var targetCell = rows[i].cells[targetIndex];

          // Store the index of the targetCell in the newOrder array
          newOrder.push(
            Array.from(this.parentNode.children).indexOf(targetCell)
          );

          // Store the ID of the sourceCell in the newIDs array
          newIDs.push(sourceCell.id);

          // Remove the sourceCell from its current position
          rows[i].deleteCell(sourceIndex);

          // Insert the sourceCell at the target position
          var nextIndex =
            targetIndex < sourceIndex ? targetIndex : targetIndex + 1;

          rows[i].insertBefore(sourceCell, rows[i].cells[targetIndex]);
        }

        // Update the column order based on the newOrder array
        var columnOrder = Array.from(
          table.querySelectorAll("th[draggable=true]"),
          function (header) {
            return header.id;
          }
        );

        const comId = `<%= company %>`;
        await updateColumn(comId, columnOrder);
        //  console.log(columnOrder)
        // Update the column order in localStorage
        // localStorage.setItem("columnOrder", JSON.stringify(columnOrder));

        return false;
      }

      var headers = document.querySelectorAll("th[draggable=true]");
      [].forEach.call(headers, function (header) {
        header.addEventListener("dragstart", handleDragStart, false);
        header.addEventListener("dragover", handleDragOver, false);
        header.addEventListener("drop", handleDrop, false);
      });
    </script>
    <script>
      document
        .getElementById("downloadButton")
        .addEventListener("click", function () {
          const optionElement = document.getElementById("downloadOptions");
          optionElement.style.display === "none"
            ? (optionElement.style.display = "block")
            : (optionElement.style.display = "none");
        });

      function openOptions(id) {
        const optionElement = document.getElementById(
          `${"downloadSingleOptions" + id}`
        );
        optionElement.style.display === "none"
          ? (optionElement.style.display = "block")
          : (optionElement.style.display = "none");
      }

      function downloadSingleEmployeeFile(option, id) {
        if (["docx", "pdf", "excel"].includes(option)) {
          window.location.href = `/v2/goals-worksheet/download/${id}?option=${option}`;
        } else {
          alert("Please, select the right format.");
        }
      }
    </script>
  </body>
</html>
