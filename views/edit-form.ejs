<!DOCTYPE html>
<html lang="en">
  <head id="applicantStyles">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>Employee Form</title>

    <link href="/css/app.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      small {
        display: block;
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <nav id="sidebar" class="sidebar js-sidebar">
        <div class="sidebar-content js-simplebar">
          <%- include('partials/navbar', { user: user, path: "companies" }); %>
        </div>
      </nav>

      <div class="main">
        <%- include('partials/header', { user: user }); %>

        <main class="content">
          <div class="container-fluid p-0">
            <!-- <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
  						<ol class="breadcrumb">
   							<li class="breadcrumb-item"><a href="/companies">Companies</a></li>
   							<li class="breadcrumb-item"><a href="/admin/<%= formData?.company?._id %>/view"><%= formData?.company?.name %></a></li>
    						<li class="breadcrumb-item active" aria-current="page"><%= formData?.name %></li>
  						</ol>
					</nav> -->
            <h3 class="fs-3 fw-semibold mb-3">Edit Employee Details</h3>
            <div class="row">
              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Update Employee Details</h5>
                  </div>
                  <div class="card-body">
                    <form
                      action="/edit-form/submit/<%= formData?._id %>"
                      method="POST"
                    >
                      <div class="form-group">
                        <input
                          type="hidden"
                          class="form-control"
                          id="company"
                          name="company"
                          value="<%= formData?.company?._id %>"
                        />
                        <% if(formData?.group) { %>
                        <input
                          type="hidden"
                          class="form-control"
                          id="group"
                          name="group"
                          value="<%= formData?.group %>"
                        />
                        <% } %>
                        <!-- <label for="company" class="input-label">Company</label>
										  <input type="text" class="form-control" id="company" name="company" placeholder="Enter company">
										  <small class="form-text text-muted">
											<button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#companyModal">&#9432;</button>
											First and company.
										  </small> -->
                      </div>
                      <div class="form-group">
                        <label for="name" class="input-label">Name</label>
                        <small class="form-text text-muted">
                          First and last name.
                        </small>
                        <input
                          type="text"
                          class="form-control"
                          id="name"
                          name="name"
                          placeholder="Enter name"
                          value="<%= formData?.name %>"
                        />
                      </div>
                    
                      <div class="form-group">
                        <label for="title" class="input-label">Title</label>
                        <small class="form-text text-muted">
                          EXACT current job title.
                        </small>
                        <input
                          type="text"
                          class="form-control"
                          id="title"
                          name="title"
                          placeholder="Enter title"
                          value="<%= formData?.title %>"
                        />
                      </div>
                      <div class="form-group">
                        <label for="jobDescription" class="input-label"
                          >Job Description</label
                        >
                        <small class="form-text text-muted">
                          Describe your key job responsibilities in your current
                          position. (3-5 bulleted statements, ranked in order of
                          importance).
                        </small>
                        <textarea
                          class="form-control"
                          id="jobDescription"
                          name="jobDescription"
                          rows="3"
                        >
<%= formData?.jobDescription ? formData?.jobDescription.trim() : "" %></textarea
                        >
                      </div>
                      <div class="form-group">
                        <label for="managerSupervisor" class="input-label"
                          >Manager/Supervisor</label
                        >
                        <small class="form-text text-muted">
                          Name and EXACT title of the one person to whom you
                          directly report; Who is responsible for your formal
                          performance reviews?
                        </small>
                        <input
                          type="text"
                          class="form-control"
                          id="managerSupervisor"
                          name="managerSupervisor"
                          placeholder="Enter manager/supervisor"
                          value="<%= formData?.managerSupervisor %>"
                        />
                      </div>
                      <div class="form-group">
                        <label for="directReports" class="input-label"
                          >Direct Reports</label
                        >
                        <small class="form-text text-muted">
                          The names and EXACT titles of those persons who report
                          directly to you; you are responsible for their formal
                          performance reviews.
                        </small>
                        <textarea
                          class="form-control"
                          id="directReports"
                          name="directReports"
                          rows="3"
                        >
<%= formData?.directReports ? formData?.directReports.trim() : "" %></textarea
                        >
                      </div>

                      <div class="form-group">
                        <label for="accountable" class="input-label"
                          >Accountable</label
                        >
                        <small class="form-text text-muted">
                          Areas of focus for which YOU, and ONLY YOU, are
                          Accountable.
                        </small>
                        <textarea
                          class="form-control"
                          id="accountable"
                          name="accountable"
                          rows="3"
                        >
<%= formData?.accountable ? formData?.accountable.trim() : "" %></textarea
                        >
                      </div>

                      <div class="form-group">
                        <label for="participate" class="input-label"
                          >Participate</label
                        >
                        <small class="form-text text-muted">
                          Activities you have responsibility to participate in
                          but for which someone else has the “A".
                        </small>
                        <textarea
                          class="form-control"
                          id="participate"
                          name="participate"
                          rows="3"
                        >
<%= formData?.participate ? formData?.participate.trim() : "" %></textarea
                        >
                      </div>

                      <!-- <div class="form-group">
										  <label for="compensation" class="input-label">Compensation</label>
										  <small class="form-text text-muted">
											How are you compensated, other than salary (types and structure of compensation, not amounts: e.g., commissions, bonuses, gain-sharing, ownership interest)?
										  </small>
										  <textarea class="form-control" id="compensation" name="compensation" rows="3"><%= formData?.compensation ? formData?.compensation.trim() : "" %></textarea>
										  
										</div> -->

                      <div class="form-group">
                        <label for="metrics" class="input-label">Metrics</label>
                        <small class="form-text text-muted">
                          How does your direct supervisor measure your success?
                        </small>
                        <textarea
                          class="form-control"
                          id="metrics"
                          name="metrics"
                          rows="3"
                        >
<%= formData?.metrics ? formData?.metrics.trim() : "" %></textarea
                        >
                      </div>

                      <div class="form-group">
                        <label for="positionalObjectives" class="input-label"
                          >Current Year Positional Objectives</label
                        >
                        <small class="form-text text-muted">
                          What are your key objectives for this fiscal year in
                          your current position? These are likely objectives
                          that are currently in written form.
                        </small>
                        <textarea
                          class="form-control"
                          id="positionalObjectives"
                          name="positionalObjectives"
                          rows="3"
                        >
<%= formData?.positionalObjectives ? formData?.positionalObjectives.trim() : "" %></textarea
                        >
                      </div>

                      <div class="form-group">
                        <label for="personalObjectives" class="input-label"
                          >Personal Objectives</label
                        >
                        <small class="form-text text-muted">
                          What are your personal (not positional) objectives
                          over the next 2-3 years and beyond?
                        </small>
                        <textarea
                          class="form-control"
                          id="personalObjectives"
                          name="personalObjectives"
                          rows="3"
                        >
<%= formData?.personalObjectives ? formData?.personalObjectives.trim() : "" %></textarea
                        >
                      </div>

                      <div class="form-group">
                        <label for="authorityLevels" class="input-label"
                          >Authority Levels</label
                        >
                        <small class="form-text text-muted">
                          What authority levels or decision rights do you have
                          for planning, spending, hiring/firing, contractual
                          relationships, structural changes, etc.?
                        </small>
                        <textarea
                          class="form-control"
                          id="authorityLevels"
                          name="authorityLevels"
                          rows="3"
                        >
<%= formData?.authorityLevels ? formData?.authorityLevels.trim() : "" %></textarea
                        >
                      </div>

                      <div class="form-group">
                        <label for="delegationOfAuthority" class="input-label"
                          >Delegation of Authority</label
                        >
                        <small class="form-text text-muted">
                          What freedom do you give to your subordinates to make
                          decisions on their own, e.g. authority levels,
                          requesting permission, submitting data, etc. Think
                          about which of your accountabilities you might be able
                          to delegate.
                        </small>
                        <textarea
                          class="form-control"
                          id="delegationOfAuthority"
                          name="delegationOfAuthority"
                          rows="3"
                        >
<%= formData?.delegationOfAuthority ? formData?.delegationOfAuthority.trim() : "" %></textarea
                        >
                      </div>

                      <!-- Add more fields with the "i" button functionality here -->
                      <button
                        type="submit"
                        id="formSubmit"
                        class="btn btn-primary btn-block mt-2"
                        style="float: right"
                      >
                        Update
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>

        <footer class="footer"><%- include('partials/footer'); %></footer>
      </div>
    </div>
    <script src="/js/app.js"></script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var ctx = document
          .getElementById("chartjs-dashboard-line")
          .getContext("2d");
        var gradient = ctx.createLinearGradient(0, 0, 0, 225);
        gradient.addColorStop(0, "rgba(215, 227, 244, 1)");
        gradient.addColorStop(1, "rgba(215, 227, 244, 0)");
        // Line chart
        new Chart(document.getElementById("chartjs-dashboard-line"), {
          type: "line",
          data: {
            labels: [
              "Jan",
              "Feb",
              "Mar",
              "Apr",
              "May",
              "Jun",
              "Jul",
              "Aug",
              "Sep",
              "Oct",
              "Nov",
              "Dec",
            ],
            datasets: [
              {
                label: "Sales ($)",
                fill: true,
                backgroundColor: gradient,
                borderColor: window.theme.primary,
                data: [
                  2115, 1562, 1584, 1892, 1587, 1923, 2566, 2448, 2805, 3438,
                  2917, 3327,
                ],
              },
            ],
          },
          options: {
            maintainAspectRatio: false,
            legend: {
              display: false,
            },
            tooltips: {
              intersect: false,
            },
            hover: {
              intersect: true,
            },
            plugins: {
              filler: {
                propagate: false,
              },
            },
            scales: {
              xAxes: [
                {
                  reverse: true,
                  gridLines: {
                    color: "rgba(0,0,0,0.0)",
                  },
                },
              ],
              yAxes: [
                {
                  ticks: {
                    stepSize: 1000,
                  },
                  display: true,
                  borderDash: [3, 3],
                  gridLines: {
                    color: "rgba(0,0,0,0.0)",
                  },
                },
              ],
            },
          },
        });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Pie chart
        new Chart(document.getElementById("chartjs-dashboard-pie"), {
          type: "pie",
          data: {
            labels: ["Chrome", "Firefox", "IE"],
            datasets: [
              {
                data: [4306, 3801, 1689],
                backgroundColor: [
                  window.theme.primary,
                  window.theme.warning,
                  window.theme.danger,
                ],
                borderWidth: 5,
              },
            ],
          },
          options: {
            responsive: !window.MSInputMethodContext,
            maintainAspectRatio: false,
            legend: {
              display: false,
            },
            cutoutPercentage: 75,
          },
        });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Bar chart
        new Chart(document.getElementById("chartjs-dashboard-bar"), {
          type: "bar",
          data: {
            labels: [
              "Jan",
              "Feb",
              "Mar",
              "Apr",
              "May",
              "Jun",
              "Jul",
              "Aug",
              "Sep",
              "Oct",
              "Nov",
              "Dec",
            ],
            datasets: [
              {
                label: "This year",
                backgroundColor: window.theme.primary,
                borderColor: window.theme.primary,
                hoverBackgroundColor: window.theme.primary,
                hoverBorderColor: window.theme.primary,
                data: [54, 67, 41, 55, 62, 45, 55, 73, 60, 76, 48, 79],
                barPercentage: 0.75,
                categoryPercentage: 0.5,
              },
            ],
          },
          options: {
            maintainAspectRatio: false,
            legend: {
              display: false,
            },
            scales: {
              yAxes: [
                {
                  gridLines: {
                    display: false,
                  },
                  stacked: false,
                  ticks: {
                    stepSize: 20,
                  },
                },
              ],
              xAxes: [
                {
                  stacked: false,
                  gridLines: {
                    color: "transparent",
                  },
                },
              ],
            },
          },
        });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var markers = [
          {
            coords: [31.230391, 121.473701],
            name: "Shanghai",
          },
          {
            coords: [28.70406, 77.102493],
            name: "Delhi",
          },
          {
            coords: [6.524379, 3.379206],
            name: "Lagos",
          },
          {
            coords: [35.689487, 139.691711],
            name: "Tokyo",
          },
          {
            coords: [23.12911, 113.264381],
            name: "Guangzhou",
          },
          {
            coords: [40.7127837, -74.0059413],
            name: "New York",
          },
          {
            coords: [34.052235, -118.243683],
            name: "Los Angeles",
          },
          {
            coords: [41.878113, -87.629799],
            name: "Chicago",
          },
          {
            coords: [51.507351, -0.127758],
            name: "London",
          },
          {
            coords: [40.416775, -3.70379],
            name: "Madrid ",
          },
        ];
        var map = new jsVectorMap({
          map: "world",
          selector: "#world_map",
          zoomButtons: true,
          markers: markers,
          markerStyle: {
            initial: {
              r: 9,
              strokeWidth: 7,
              stokeOpacity: 0.4,
              fill: window.theme.primary,
            },
            hover: {
              fill: window.theme.primary,
              stroke: window.theme.primary,
            },
          },
          zoomOnScroll: false,
        });
        window.addEventListener("resize", () => {
          map.updateSize();
        });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var date = new Date(Date.now() - 5 * 24 * 60 * 60 * 1000);
        var defaultDate =
          date.getUTCFullYear() +
          "-" +
          (date.getUTCMonth() + 1) +
          "-" +
          date.getUTCDate();
        document.getElementById("datetimepicker-dashboard").flatpickr({
          inline: true,
          prevArrow: '<span title="Previous month">&laquo;</span>',
          nextArrow: '<span title="Next month">&raquo;</span>',
          defaultDate: defaultDate,
        });
      });

      document
        .getElementById("downloadButton")
        .addEventListener("click", function () {
          // Gather checked values of header checkboxes
          const headerCheckboxes = document.querySelectorAll(
            ".header-checkbox:checked"
          );
          const headerValues = Array.from(headerCheckboxes).map(
            (checkbox) => checkbox.dataset.column
          );

          window.location.href = `/admin/download/${headerValues}`;
        });
    </script>
  </body>
</html>
