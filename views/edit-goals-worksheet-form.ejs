  <!-- main content end -->
  <%- include('partials/html-scripts'); %>
  <script>
    function selectedQuarterOption(quarter) {
      const quarterSelect = document.getElementById("quarter");
      const options = quarterSelect.options;
      for (let i = 0; i < options.length; i++) {
        if (options[i].value === quarter) {
          options[i].selected = true;
          break;
        }
      }
    }

    selectedQuarterOption("<%= goalsWorksheet?.quarter %>"); // Call the function with the quarter value

