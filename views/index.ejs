<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="img/photos/symbol.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>Accountability</title>

    <!-- Admin Kit CSS File  -->
    <link href="css/app.css" rel="stylesheet" />
    <!-- <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    /> -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <style>
    .border {
      border: 2px solid #f00; /* 2px solid red border */
    }
    .spinner-loader {
      border: 4px solid #1e5c99;
      border-radius: 50%;
      border-top: 4px solid transparent;
      width: 16px;
      height: 16px;
      -webkit-animation: spin 1s linear infinite; /* Safari */
      animation: spin 1s linear infinite;
    }

    /* Safari */
    @-webkit-keyframes spin {
      0% {
        -webkit-transform: rotate(0deg);
      }
      100% {
        -webkit-transform: rotate(360deg);
      }
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }
  </style>

  <body>
    <div class="wrapper">
      <nav id="sidebar" class="sidebar js-sidebar">
        <div class="sidebar-content js-simplebar">
          <%- include('partials/navbar', { user: user, path: "dashboard" }); %>
        </div>
      </nav>

      <div class="main">
        <%- include('partials/header', { user: user }); %>

        <main class="content">
          <div class="container-fluid p-0">
            <div
              class="d-flex align-items-center justify-content-between gap-4"
            >
              <h3 class="fs-3 fw-semibold mb-3">Analytics Dashboard</h3>
              <% if(user?.role === 1) { %>
              <a href="/org-hierarchy" class="link-opacity-100"
                >Org Hierarchy</a
              >
              <% } %>
            </div>

            <!-- analytic part -->
            <div class="row">
              <div class="col-xl-6 col-xxl-5">
                <div class="w-100">
                  <div class="row">
                    <div class="col-sm-6">
                      <div class="card">
                        <div class="card-body">
                          <div class="row">
                            <div class="col mt-0">
                              <h5 class="card-title">Companies</h5>
                            </div>

                            <div class="col-auto">
                              <div class="stat text-primary">
                                <i
                                  class="align-middle"
                                  data-feather="globe"
                                ></i>
                              </div>
                            </div>
                          </div>
                          <h1 class="mt-1 mb-3">
                            <%= analytics.totalCompanies %>
                          </h1>
                          <div class="mb-0"></div>
                        </div>
                      </div>
                      <div class="card">
                        <div class="card-body">
                          <div class="row">
                            <div class="col mt-0">
                              <h5 class="card-title">Employees</h5>
                            </div>

                            <div class="col-auto">
                              <div class="stat text-primary">
                                <i
                                  class="align-middle"
                                  data-feather="users"
                                ></i>
                              </div>
                            </div>
                          </div>
                          <h1 class="mt-1 mb-3">
                            <%= analytics.totalFormData %>
                          </h1>
                          <div class="mb-0"></div>
                        </div>
                      </div>
                    </div>
                    <div class="col-sm-6">
                      <div class="card">
                        <div class="card-body">
                          <div class="row">
                            <div class="col mt-0">
                              <h5 class="card-title">Groups</h5>
                            </div>

                            <div class="col-auto">
                              <div class="stat text-primary">
                                <i
                                  class="align-middle"
                                  data-feather="aperture"
                                ></i>
                              </div>
                            </div>
                          </div>
                          <h1 class="mt-1 mb-3">
                            <%= analytics.totalGroups %>
                          </h1>
                          <div class="mb-0"></div>
                        </div>
                      </div>
                      <div class="card">
                        <div class="card-body">
                          <div class="row">
                            <div class="col mt-0">
                              <h5 class="card-title">Admins</h5>
                            </div>

                            <div class="col-auto">
                              <div class="stat text-primary">
                                <i
                                  class="align-middle"
                                  data-feather="activity"
                                ></i>
                              </div>
                            </div>
                          </div>
                          <h1 class="mt-1 mb-3"><%= analytics.totalAdmin %></h1>
                          <div class="mb-0"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-xl-6 col-xxl-7">
                <div class="card flex-fill w-100">
                  <div class="card-header">
                    <div class="card-title mb-0">Employees</div>
                  </div>
                  <div class="card body py-3">
                    <div style="width: auto; min-height: 180px">
                      <canvas id="barChart2"></canvas>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- end -->
            <div class="row m-0">
              <div class="card">
                <div class="card-header">Employees Vs Companies</div>
                <div class="card-body">
                  <canvas
                    id="lineChart"
                    width="1920"
                    height="1080"
                    style="width: 100%; height: 100%; display: block"
                  ></canvas>
                </div>
              </div>
            </div>

            <!-- org chart  -->
            <!-- <div class="row m-0">
              <div class="card">
                <div class="card-header">Organizational Hierarchy</div>
                <div class="card-body">
                  <div
                    id="svg-tree"
                    width="1920"
                    height="1080"
                    style="width: 100%; height: 100%; display: block"
                  ></div>
                </div>
              </div>
            </div> -->
          </div>
        </main>

        <footer class="footer"><%- include('partials/footer'); %></footer>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script> -->
    <!-- Admin Kit JS File  -->
    <script src="js/app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <script>
      function showLoading(state) {
        const loader = document.getElementById("loader");
        if (state === true) {
          loader.style.display = "block";
        } else {
          loader.style.display = "none";
        }
      }

      window.addEventListener("DOMContentLoaded", async function () {
        // fetch the analytics data
        const analyticsData = await fetchAnalytics();
        // console.log(analyticsData);
        // JavaScript code to create the bar chart

        // Sample data and labels
        const data = analyticsData.formDataCounts;
        const labels = analyticsData.companyNames;

        // const canvas1 = document.getElementById("barChart1");
        // const ctx1 = canvas1.getContext("2d");

        // const barChart1 = new Chart(ctx1, {
        //   type: "bar",
        //   data: {
        //     labels: labels,
        //     datasets: [
        //       {
        //         label: "Employees ",
        //         data: data,
        //         backgroundColor: "grey",
        //       },
        //     ],
        //   },
        //   options: {
        //     scales: {
        //       y: {
        //         beginAtZero: true,
        //       },
        //     },
        //   },
        // });

        // JavaScript code to create the bar chart 1
        const canvas2 = document.getElementById("barChart2");
        const ctx2 = canvas2.getContext("2d");
        const barChart2 = new Chart(ctx2, {
          type: "bar",
          data: {
            labels: labels,
            datasets: [
              {
                label: "Employees ",
                data: data,
                backgroundColor: window.theme.primary,
                borderColor: window.theme.primary,
                hoverBackgroundColor: window.theme.primary,
                hoverBorderColor: window.theme.primary,
                barPercentage: 0.75,
                categoryPercentage: 0.5,
              },
            ],
          },
          options: {
            maintainAspectRatio: false,
            legend: {
              display: false,
            },
            scales: {
              y: {
                beginAtZero: true,
              },
              yAxes: [
                {
                  gridLines: {
                    display: false,
                  },
                  stacked: false,
                  ticks: {
                    stepSize: 10,
                  },
                },
              ],
              xAxes: [
                {
                  stacked: false,
                  gridLines: {
                    color: "transparent",
                  },
                },
              ],
            },
          },
        });

        // JavaScript code to create the line chart
        const canvas3 = document.getElementById("lineChart");
        const ctx3 = canvas3.getContext("2d");

        const gradient = ctx3.createLinearGradient(0, 0, 0, 225);
        gradient.addColorStop(0, "rgba(215, 227, 244, 1)");
        gradient.addColorStop(1, "rgba(215, 227, 244, 0)");

        const lineChart = new Chart(ctx3, {
          type: "line",
          data: {
            labels: labels,
            datasets: [
              {
                label: "Employess vs Companies",
                data: data,
                fill: true,
                backgroundColor: gradient,
                borderColor: window.theme.primary,
              },
            ],
          },
          options: {
            maintainAspectRatio: false,
            legend: {
              display: true,
            },
            tooltips: {
              intersect: true,
            },
            hover: {
              intersect: true,
            },
            plugins: {
              filler: {
                propagate: false,
              },
            },
            scales: {
              y: {
                beginAtZero: true,
              },
              xAxes: [
                {
                  reverse: true,
                  gridLines: {
                    color: "rgba(0,0,0,0.0)",
                  },
                },
              ],
              yAxes: [
                {
                  ticks: {
                    stepSize: 10,
                  },
                  display: true,
                  borderDash: [3, 3],
                  gridLines: {
                    color: "rgba(128,128,128,0.25)",
                  },
                },
              ],
            },
          },
        });
      });

      // fetch analytics function
      async function fetchAnalytics() {
        try {
          // showLoading(true);
          const response = await fetch("/analytics");
          const data = await response.json();
          if (response.status === 200) {
            return data; // Return the data if the request is successful
          } else {
            console.error("Failed to fetch analytics:", response.status);
            return null; // Return null in case of an error
          }
        } catch (error) {
          console.error("An error occurred:", error.message);
          return null; // Return null in case of an error
        } finally {
          // showLoading(false);
        }
      }
    </script>
  </body>
</html>
