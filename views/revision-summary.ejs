<!DOCTYPE html>
<html lang="en">
  <head id="applicantStyles">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>Admin Actions</title>

    <link href="/css/app.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <!-- bootstrap 5.3 cdn  -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> -->

    <style>
      /* Style the buttons that are used to open and close the accordion panel */
      .accordion {
        background-color: #fff;
        color: #444;
        cursor: pointer;
        padding: 18px;
        width: 100%;
        text-align: left;
        border: none;
        outline: none;
        transition: 0.4s;
        display: flex;
        justify-content: space-between;
      }

      /* Add a background color to the button if it is clicked on (add the .active class with JS), and when you move the mouse over it (hover) */
      .active-acc,
      .accordion:hover {
        background-color: #ccc;
        border: 1px solid black;
      }

      /* Style the accordion panel. Note: hidden by default */
      .panel {
        padding: 0 18px;
        background-color: white;
        display: none;
        overflow: hidden;
      }
      .dropdown {
        width: 100%;
      }
      option:hover {
        background-color: #1a1a1a;
        color: #fff;
      }
      .selectValue {
        background-color: #fff;
        color: #444;
        cursor: pointer;
        padding: 10px;
        width: 100%;
        text-align: left;
        border: none;
        outline: none;
        transition: 0.4s;
      }
      .disabled {
        color: #ccc;
      }
      .textarea {
        padding: 18px;
        width: 100%;
        height: 10rem;
        margin: 2rem 0;
        border-radius: 0.7rem;
      }
      .emailAInput {
        padding: 18px;
        width: 100%;
        margin: 2rem 0;
      }

      .panel4 > label {
        border: 1px solid #444;
        margin: 0.5rem 0;
        padding: 1rem;
        cursor: pointer;
      }
      #submitBtn {
        width: 152px;
        margin: 1rem 0;
        display: flex;
        align-items: center;
        justify-content: space-around;
      }
      .error {
        color: red;
        font-weight: 800;
      }

      .spinner-loader {
        border: 4px solid #f3f3f3;
        border-radius: 50%;
        border-top: 4px solid transparent;
        width: 16px;
        height: 16px;
        -webkit-animation: spin 1s linear infinite; /* Safari */
        animation: spin 1s linear infinite;
      }

      /* Safari */
      @-webkit-keyframes spin {
        0% {
          -webkit-transform: rotate(0deg);
        }
        100% {
          -webkit-transform: rotate(360deg);
        }
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <nav id="sidebar" class="sidebar js-sidebar">
        <div class="sidebar-content js-simplebar">
          <%- include('partials/navbar', { user: user, path: "revision" }); %>
        </div>
      </nav>

      <div class="main">
        <%- include('partials/header', { user: user }); %>

        <main class="content">
          <div class="container-fluid p-0">
            <div class="row">
              <div class="col-md-4 col-xs-12 col-sm-12">
                <h1 class="h3 mb-3">Admin Actions</h1>
              </div>
            </div>
            <div
              class="modal"
              id="errorModal"
              tabindex="-1"
              aria-labelledby="exampleModalLabel"
              aria-hidden="true"
            >
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">
                      Message
                    </h5>
                    <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Close"
                    ></button>
                  </div>
                  <div class="modal-body">
                    <p class="message-para"></p>
                  </div>
                  <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                      Okay
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <form
              onsubmit="sendRevisionData(event)"
              class="table-responsive"
              style="max-height: 900px; max-width: 100%; overflow: auto"
            >
              <div class="accordion actionAccordion">
                Choose Action
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel actionPanel">
                <select id="actionDropDown" class="dropdown action">
                  <option class="selectValue disabled" value="">
                    Choose Action
                  </option>
                  <option class="selectValue" id="sendAoa" value="sendAoa">
                    Send AOA
                  </option>
                  <option
                    class="selectValue"
                    id="sendSelfEvaluation"
                    value="sendSelfEvaluation"
                  >
                    Send Self-evaluation
                  </option>
                  <option
                    class="selectValue"
                    id="sendGoalsWorksheet"
                    value="sendGoalsWorksheet"
                  >
                    Send Goals Worksheet
                  </option>
                  <!-- <option class="selectValue" id="sendManagerEvaluation" value="sendManagerEvaluation">Send Manager Evaluation</option> -->
                </select>
              </div>
              <div class="accordion accordion1">
                Select Companies
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel panel1">
                <select
                  id="dropdown1"
                  class="dropdown company"
                  size="<%= companies?.length + 1 %>"
                >
                  >
                  <option class="selectValue disabled" value="">
                    Choose Company
                  </option>
                  <% companies.forEach((item, index) => { %>
                  <option
                    id="<%= item._id %>"
                    class="selectValue"
                    value="<%= item._id %>"
                  >
                    <%= item.name %>
                  </option>
                  <% }); %>
                </select>
              </div>
              <div class="accordion accordion2">
                Select Employees
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel panel2">
                <select id="dropdown2" class="dropdown employees"></select>
              </div>

              <div class="accordion accordion3">
                Email Message
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel panel3">
                <textarea
                  class="textarea"
                  id="emailContent"
                  placeholder="Write Email content "
                ></textarea>
              </div>

              <div class="accordion accordion4">
                Content to add
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel panel4">
                <label>
                  <input
                    type="checkbox"
                    name="addEditLink"
                    id="addEditLink"
                    value="addEditLink"
                  />
                  Add Edit Link
                </label>

                <label id="add-pdf">
                  <input type="checkbox" name="addPDF" value="addPDF" /> Add PDF
                </label>

                <label id="add-docs">
                  <input type="checkbox" name="addDocs" value="addDocs" /> Add
                  Docs
                </label>
              </div>
              <div class="accordion timeAccordion" style="display: none">
                Quarter & Year
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel timePanel p-3">
                <select
                  class="form-select mb-3"
                  onchange="handleChangeValue('quarter')"
                  id="quarter"
                  name="quarter"
                >
                  <option selected disabled>Choose quarter</option>
                  <option value="Q1">Q1 (January - March)</option>
                  <option value="Q2">Q2 (April - June)</option>
                  <option value="Q3">Q3 (July - September)</option>
                  <option value="Q4">Q4 (October - December)</option>
                </select>
                <div class="mb-3">
                  <label for="year" class="form-label">Year</label>
                  <input
                    type="number"
                    class="form-control"
                    onchange="handleChangeValue('year')"
                    id="year"
                    name="year"
                    placeholder="YYYY"
                    min="2020"
                    max="2099"
                    maxlength="4"
                    minlength="4"
                    onwheel="blurOnWheel()"
                  />
                </div>
              </div>
              <div class="accordion accordion5">
                Email Address
                <i class="align-middle" data-feather="chevron-down"></i>
              </div>
              <div class="panel panel5 p-3">
                <div class="input-group mb-3">
                  <span class="input-group-text" id="basic-addon1">To</span>
                  <input
                    type="email"
                    id="emailTo"
                    class="form-control"
                    placeholder="emailTo@email.com"
                    aria-label="Email"
                    aria-describedby="basic-addon1"
                  />
                </div>
                <div class="input-group mb-3">
                  <span class="input-group-text" id="basic-addon2">Cc</span>
                  <input
                    type="email"
                    id="emailCc"
                    class="form-control"
                    placeholder="emailCc@email.com"
                    aria-label="Email"
                    aria-describedby="basic-addon2"
                  />
                </div>
              </div>

              <button
                type="submit"
                id="submitBtn"
                class="btn btn-primary btn-lg"
              >
                Send Email
                <span
                  id="loader"
                  style="display: none; margin-left: 8px"
                  class="spinner-loader"
                ></span>
              </button>
            </form>
          </div>
        </main>
        <footer class="footer"><%- include('partials/footer'); %></footer>
      </div>
    </div>

    <script src="/js/app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <script>
      const revFormData = {
        company: "",
        employee: "",
        action: "",
      };
      const acc = document.getElementsByClassName("accordion");

      for (let i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
          /* Toggle between adding and removing the "active" class,
            to highlight the button that controls the panel */
          this.classList.toggle("active-acc");

          /* Toggle between hiding and showing the active panel */
          const panel = this.nextElementSibling;
          if (panel.style.display === "block") {
            panel.style.display = "none";
          } else {
            panel.style.display = "block";
          }
        });
      }

      const selectElement = document.getElementById("actionDropDown");
      selectElement.size = selectElement.options.length;

      const employeeListContainer = document.querySelector(".employees");
      // Function to fetch employees based on the selected company
      function fetchEmployeesByCompany(companyId) {
        // Replace this with your actual AJAX request to fetch employees
        const url = `/fetchEmployees/${companyId}`;
        fetch(url)
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response was not ok");
            }
            return response.json();
          })
          .then((data) => {
            // Create an array to hold the option elements
            const optionElements = [];
            const defaultoption = document.createElement("option");
            defaultoption.innerText = "Choose Employee";
            defaultoption.value = "";
            defaultoption.classList.add("selectValue", "disabled");
            optionElements.push(defaultoption);
            // Create HTML markup for the employee list
            data.forEach((FormData) => {
              const option = document.createElement("option");
              option.innerText = FormData.name;
              option.value = `${FormData?._id},${FormData?.email}`;
              option.setAttribute("id", FormData._id);
              option.classList.add("selectValue");
              optionElements.push(option);
            });

            // Append the option elements to the select element
            employeeListContainer.innerHTML = "";
            optionElements.forEach((option) => {
              employeeListContainer.appendChild(option);
            });
            employeeListContainer.size = optionElements.length;
            // openNextAccordion(2)
          })
          .catch((error) => {
            console.error("Error fetching employees:", error);
          });
      }

      // function to select action
      const actionSelect = document.querySelector(".action");

      actionSelect.addEventListener("change", function () {
        const selectedAction = this.value;
        revFormData.action = selectedAction;
        // DONE: complete send manager evaluation
        if (selectedAction === "sendSelfEvaluation") {
          const emailContent = document.getElementById("emailContent");
          const content = `You are being asked to complete a self evaluation of your performance, based on your most recent Assignment of Accountability. Once this evaluation is completed, your manager will receive a copy and will complete their evaluation of your performance.\n\nPlease click the following link:\n`;
          emailContent.innerHTML = content;
          revFormData.message = content;

          document.querySelector(".timeAccordion").style.display = "flex";

          document.getElementById("addEditLink").checked = true;
          revFormData["addEditLink"] = "addEditLink";

          document.getElementById("add-pdf").style.display = "inline-block";
          document.getElementById("add-docs").style.display = "inline-block";
        } else if (selectedAction === "sendManagerEvaluation") {
          const emailContent = document.getElementById("emailContent");
          const content = `You are being asked to complete a manager evaluation of your employee, based on their most recent Assignment of Accountability. Once this evaluation is completed, you will receive a copy.\n\nPlease click the following link:\n`;
          emailContent.innerHTML = content;
          revFormData.message = content;

          document.querySelector(".timeAccordion").style.display = "flex";

          document.getElementById("addEditLink").checked = true;
          revFormData["addEditLink"] = "addEditLink";

          document.getElementById("add-pdf").style.display = "inline-block";
          document.getElementById("add-docs").style.display = "inline-block";
        } else if (selectedAction === "sendGoalsWorksheet") {
          const emailContent = document.getElementById("emailContent");
          const content = `You are being asked to complete a goals worksheet, in the online Assignment of Accountability application. Once your goals worksheet is completed, you will receive an email copy.`;
          emailContent.innerHTML = content;
          revFormData.message = content;

          document.querySelector(".timeAccordion").style.display = "flex";

          document.getElementById("addEditLink").checked = true;
          revFormData["addEditLink"] = "addEditLink";

          document.getElementById("add-pdf").style.display = "none";
          document.getElementById("add-docs").style.display = "none";
        } else {
          emailContent.innerHTML = ``;
          revFormData.message = "";

          document.querySelector(".timeAccordion").style.display = "none";

          document.getElementById("addEditLink").checked = false;
          revFormData["addEditLink"] = "";

          document.getElementById("add-pdf").style.display = "inline-block";
          document.getElementById("add-docs").style.display = "inline-block";
        }

        const acc1 = document.querySelector(".actionAccordion");
        const acc2 = document.querySelector(".accordion1");
        const selectedOption = document.getElementById(this.value);
        acc1.innerText = "ACTION: " + selectedOption.innerText;
        acc1.classList.toggle("active-acc");
        acc2.classList.toggle("active-acc");
        acc1.nextElementSibling.style.display = "none";
        acc2.nextElementSibling.style.display = "block";
      });

      // function to select year and quarter
      function handleChangeValue(elem) {
        const name = document.getElementById(elem).name;
        const value = document.getElementById(elem).value;
        revFormData[name] = value;
      }

      // function to select company
      const companySelect = document.querySelector(".company");
      // Event listener for the company dropdown change
      companySelect.addEventListener("change", async function () {
        const selectedCompanyId = this.value;
        const acc1 = document.querySelector(".accordion1");
        const acc2 = document.querySelector(".accordion2");
        const selectedOption = document.getElementById(this.value);
        acc1.innerText = "COMPANY:   " + selectedOption.innerText;
        revFormData.company = selectedCompanyId;
        // Check if a valid company is selected (not the "Select Companies" option)
        if (selectedCompanyId) {
          // Call the function to fetch employees by company
          await fetchEmployeesByCompany(selectedCompanyId);
        }
        acc1.classList.toggle("active-acc");
        acc2.classList.toggle("active-acc");
        acc1.nextElementSibling.style.display = "none";
        acc2.nextElementSibling.style.display = "block";
      });

      // function to select employee
      employeeListContainer.addEventListener("change", function () {
        const selectedEmployee = this.value;
        const [selectedEmployeeId, selectedEmployeeEmail] =
          selectedEmployee.split(",");
        document.getElementById("emailTo").value = selectedEmployeeEmail;
        revFormData.emailTo = selectedEmployeeEmail;

        // const selectedEmployeeId = this.value;
        const acc2 = document.querySelector(".accordion2");
        const acc3 = document.querySelector(".accordion3");
        const selectedOption = document.getElementById(selectedEmployeeId);
        acc2.innerText = "EMPLOYEE:   " + selectedOption.innerText;
        revFormData.employee = selectedEmployeeId;
        acc2.classList.toggle("active-acc");
        acc3.classList.toggle("active-acc");
        acc2.nextElementSibling.style.display = "none";
        acc3.nextElementSibling.style.display = "block";
      });

      // function to capture message
      const emailMessage = document.querySelector(".textarea");

      emailMessage.addEventListener("change", function () {
        revFormData.message = this.value;
      });

      // function to get checkbox
      const checkboxes = document.querySelectorAll('input[type="checkbox"]');

      checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener("change", function () {
          if (this.checked) {
            revFormData[this.name] = this.value;
          } else {
            // Handle the case when the checkbox is unchecked
            delete revFormData[this.name];
          }
        });

        checkbox.addEventListener("keydown", function (event) {
          // Check if the pressed key is Enter (keyCode 13)
          if (event.keyCode === 13) {
            event.preventDefault();
            const acc4 = document.querySelector(".accordion4");
            const acc5 = document.querySelector(".accordion5");
            acc4.classList.toggle("active-acc");
            acc5.classList.toggle("active-acc");
            acc4.nextElementSibling.style.display = "none";
            acc5.nextElementSibling.style.display = "block";
          }
        });
      });

      // function to get email address
      const emailTo = document.getElementById("emailTo");

      emailTo.addEventListener("change", function () {
        revFormData.emailTo = this.value;
      });
      emailTo.addEventListener("keydown", function (event) {
        // Check if the pressed key is Enter (keyCode 13)
        if (event.keyCode === 13) {
          event.preventDefault();
          const acc5 = document.querySelector(".accordion5");
          acc5.classList.toggle("active-acc");
          acc5.nextElementSibling.style.display = "none";
        }
      });

      // function to get manager email address
      const emailCc = document.getElementById("emailCc");

      emailCc.addEventListener("change", function () {
        revFormData.emailCc = this.value;
      });
      emailCc.addEventListener("keydown", function (event) {
        // Check if the pressed key is Enter (keyCode 13)
        if (event.keyCode === 13) {
          event.preventDefault();
          const acc5 = document.querySelector(".accordion5");
          acc5.classList.toggle("active-acc");
          acc5.nextElementSibling.style.display = "none";
        }
      });

      function showLoading(state) {
        const submitBtn = document.getElementById("submitBtn");
        const loader = document.getElementById("loader");
        if (state === true) {
          loader.style.display = "block";
          submitBtn.disabled = true;
        } else {
          loader.style.display = "none";
          submitBtn.disabled = false;
        }
      }

      function showMessageModal(message) {
        const errorElement = document.querySelector(".message-para");
        errorElement.innerText = message;
        const modal = document.getElementById("errorModal");
        const bootstrapModal = new bootstrap.Modal(modal);
        bootstrapModal.show();
      }

      function sendRevisionData(event) {
        event.preventDefault();

        if (!revFormData.action) {
          showMessageModal("Action Is Needed.");
          return;
        } else if (!revFormData.employee) {
          showMessageModal("Employee Data Needed.");
          return;
        } else if (!revFormData.message) {
          showMessageModal("Message Content Needed.");
          return;
        } else if (!revFormData.emailTo) {
          showMessageModal("Email Address Data Needed.");
          return;
        } else if (!revFormData.company) {
          showMessageModal("Company Data Needed.");
          return;
        }

        const jsonData = JSON.stringify(revFormData);

        // Send a POST request to /send-revision
        showLoading(true);
        fetch("/send-revision", {
          method: "POST",
          body: jsonData,
          mode: "cors",
          cache: "no-cache",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response is not ok.");
            }
            // You can parse the response
            showLoading(false);
            return response.json();
          })
          .then((data) => {
            // Handle the response data here
            if (data?.message) {
              showMessageModal(data?.message);
            } else {
              showMessageModal("Email Successfully sent.");
            }

            setTimeout(() => {
              window.location.href = `/email-success?to=${revFormData?.emailTo}`;
            }, 3000);
          })
          .catch((error) => {
            console.error("Error sending revision data:", error);
            if (error?.message) {
              showMessageModal(error?.message);
            } else {
              showMessageModal("Something went wrong while sending email.");
            }
          });
      }

      function blurOnWheel() {
        document.getElementById("year").blur();
      }
    </script>
  </body>
</html>
