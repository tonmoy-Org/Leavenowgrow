<%- include('partials/html-head', { siteTitle: "Goals Worksheet" }); %>
<body style="font-family: 'Poppins', sans-serif">
  <!-- main content start -->
  <div class="wrapper">
    <div class="main">
      <main class="content">
        <div class="container-fluid">
          <div
            class="modal fade"
            id="emailModal"
            tabindex="-1"
            aria-labelledby="emailModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5" id="emailModalLabel">
                    Send Goals Worksheet
                  </h1>
                  <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                  ></button>
                </div>
                <div class="modal-body">
                  <form onsubmit="sendEmail(event)" class="row g-3">
                    <input
                      type="hidden"
                      name="groupId"
                      value="<%= group ? groupId : '' %>"
                    />
                    <input
                      type="hidden"
                      name="compId"
                      value="<%= companyId %>"
                    />
                    <div class="">
                      <label for="emailInput" class="form-label"
                        >Email address</label
                      >
                      <input
                        type="email"
                        name="email"
                        class="form-control"
                        id="emailInput"
                        placeholder="name@example.com"
                      />
                    </div>
                    <div class="">
                      <label for="subject" class="form-label">Subject</label>
                      <input
                        type="text"
                        name="subject"
                        class="form-control"
                        id="subject"
                        placeholder="Email subject"
                        value="Please fill out your Goals Worksheet"
                      />
                    </div>
                    <div class="">
                      <label for="emailContent" class="form-label"
                        >Content</label
                      >
                      <textarea
                        name="emailContent"
                        class="form-control"
                        id="emailContent"
                        rows="5"
                      >
Please click on the following link to complete your Goals Worksheet.
                      </textarea>
                    </div>
                    <div class="">
                      <label for="link" class="form-label">Edit Link</label>
                      <input
                        type="text"
                        name="editLink"
                        class="form-control"
                        id="link"
                        placeholder="Edit Link"
                        value="<%= editLink %>"
                      />
                    </div>
                    <div>
                      <button
                        type="submit"
                        class="btn btn-primary mb-3 d-flex justify-content-around align-items-center gap-2"
                        id="submitBtn"
                      >
                        Send Email
                        <span
                          id="loader"
                          style="display: none"
                          class="spinner-border spinner-border-sm"
                        ></span>
                      </button>
                    </div>
                  </form>
                </div>
                <div class="modal-footer">
                  <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <div
                    class="d-flex align-items-center justify-content-between gap-2"
                  >
                    <div>
                      <h2 class="card-title">Goals Worksheet</h2>
                      <h2 class="card-title">Company: <%= companyName %></h2>
                    </div>
                    <% if(!(user?.level === "6")) { %>
                    <button
                      type="button"
                      class="btn btn-secondary float-end"
                      data-bs-toggle="modal"
                      data-bs-target="#emailModal"
                    >
                      Send Goals Worksheet
                    </button>
                    <% }; %>
                  </div>
                </div>
                <div class="card-body">
                  <form action="/submit-goals-worksheet" method="post">
                    <input
                      type="hidden"
                      name="company"
                      value="<%= companyId %>"
                    />
                    <% if(group) { %>
                    <input
                      type="hidden"
                      name="group"
                      value="<%= group ? groupId : '' %>"
                    />
                    <% } %>

                    <div class="mb-3">
                      <select
                        class="form-select mb-3"
                        id="quarter"
                        name="quarter"
                        required
                      >
                        <option selected disabled>Choose quarter</option>
                        <option value="Q1">Q1 (January - March)</option>
                        <option value="Q2">Q2 (April - June)</option>
                        <option value="Q3">Q3 (July - September)</option>
                        <option value="Q4">Q4 (October - December)</option>
                      </select>
                      <div class="invalid-feedback">
                        Please select a valid quarter.
                      </div>
                    </div>
                    <div class="mb-3">
                      <label for="year" class="form-label">Term Period</label>
                      <input
                        type="text"
                        class="form-control"
                        id="year"
                        name="year"
                        aria-describedby="yearHelp"
                        pattern="(?:(?:18|19|20|21)[0-9]{2})"
                        required
                      />
                      <div class="valid-feedback">Looks good!</div>
                      <div class="invalid-feedback">
                        Please enter a valid year.
                      </div>
                    </div>
                    <div class="mb-3">
                      <label for="name" class="form-label">Name</label>
                      <input
                        type="text"
                        class="form-control"
                        id="gw-name"
                        name="name"
                        aria-describedby="nameHelp"
                        value="<%= editUser?.name ?? '' %>"
                        required
                      />
                      <small class="form-text text-muted">
                        First and Last Name
                      </small>
                      <div class="valid-feedback">Looks good!</div>
                      <div class="invalid-feedback">Please type a name.</div>
                    </div>

                    <div class="mb-3">
                      <label for="email" class="form-label">Email</label>
                      <input
                        type="text"
                        class="form-control"
                        id="gw-email"
                        name="email"
                        aria-describedby="emailHelp"
                        value="<%= editUser?.email ?? '' %>"
                        required
                      />
                      <small class="form-text text-muted">
                        Email Address
                      </small>
                      <div class="valid-feedback">Looks good!</div>
                      <div class="invalid-feedback">Please type a email.</div>
                    </div>

                    <div class="accordion" id="accordionExample">
                      <div class="accordion-item">
                        <h2 class="accordion-header">
                          <button
                            class="accordion-button"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseOne"
                            aria-expanded="true"
                            aria-controls="collapseOne"
