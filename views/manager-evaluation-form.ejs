<!DOCTYPE html>
<html lang="en">
  <head id="applicantStyles">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>Manager Evaluation Form</title>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
      integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />

    <!-- bootstrap 5.3 cdn  -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      label {
        font-weight: 600;
        font-size: 18px;
      }
      small {
        display: block;
      }
    </style>
  </head>

  <body style="background-color: #4287f5">
    <div class="wrapper">
      <div class="main p-lg-5 p-2">
        <main class="content">
          <div class="container-fluid">
            <div
              class="modal fade"
              id="videoModal1"
              tabindex="-1"
              aria-labelledby="videoModalLabel1"
              aria-hidden="true"
            >
              <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5" id="videoModalLabel1">
                      Introduction
                    </h1>
                    <button
                      onclick="pauseVideo('video1')"
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Close"
                    ></button>
                  </div>
                  <div class="modal-body">
                    <div
                      class="d-flex justify-content-center align-items-center"
                    >
                      <video id="video1" width="800" controls="controls">
                        <source
                          src="/videos/Manager-Evaluation-Intro-Video.mp4"
                          type="video/mp4"
                        />
                      </video>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button
                      onclick="pauseVideo('video1')"
                      type="button"
                      class="btn btn-secondary"
                      data-bs-dismiss="modal"
                    >
                      Close
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <!-- employee original AOA  -->
              <div class="col-lg-6 col-md-12">
                <div class="col-12" style="margin: 0 auto">
                  <!-- tabs to select which form  -->
                  <ul
                    class="bg-white p-2 rounded nav nav-pills justify-content-center mb-3"
                    id="pills-tab"
                    role="tablist"
                  >
                    <li class="nav-item" role="presentation">
                      <button
                        class="nav-link active"
                        style="width: 192px"
                        id="pills-aoa-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-aoa"
                        type="button"
                        role="tab"
                        aria-controls="pills-aoa"
                        aria-selected="true"
                      >
                        AOA
                      </button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button
                        class="nav-link"
                        style="width: 192px"
                        id="pills-self-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-self"
                        type="button"
                        role="tab"
                        aria-controls="pills-self"
                        aria-selected="false"
                      >
                        Self Evaluation
                      </button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button
                        class="nav-link"
                        style="width: 192px"
                        id="pills-manager-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-manager"
                        type="button"
                        role="tab"
                        aria-controls="pills-manager"
                        aria-selected="false"
                      >
                        Manager Evaluation
                      </button>
                    </li>
                  </ul>
                  <!-- tab content  -->
                  <div class="tab-content" id="pills-tabContent">
                    <!-- original AOA  -->
                    <div
                      class="tab-pane fade show active"
                      id="pills-aoa"
                      role="tabpanel"
                      aria-labelledby="pills-aoa-tab"
                      tabindex="0"
                    >
                      <div class="card">
                        <div class="card-header">
                          <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-light">
                              <i class="fas fa-user"></i>
                            </button>
                            <h5 class="card-title mb-0">
                              Original Employee AOA
                            </h5>
                          </div>
                        </div>
                        <div class="card-body">
                          <form>
                            <div class="form-group"></div>
                            <div class="form-group">
                              <label for="name" class="input-label">Name</label>
                              <small class="form-text text-muted">
                                First and last name.
                              </small>
                              <input
                                type="text"
                                class="form-control"
                                id="name"
                                name="name"
                                placeholder="Enter name"
                                value="<%= formData.name %>"
                              />
                            </div>
                            <div class="form-group">
                              <label for="title" class="input-label"
                                >Title</label
                              >
                              <small class="form-text text-muted">
                                EXACT current job title.
                              </small>
                              <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                placeholder="Enter title"
                                value="<%= formData.title %>"
                              />
                            </div>
                            <div class="form-group mb-1">
                              <label for="jobDescription" class="input-label"
                                >Job Description</label
                              >
                              <small class="form-text text-muted">
                                In brief, what are you responsible for in your
                                current position? (3-5 bulleted statements,
                                ranked in order of importance).
                              </small>
                              <textarea
                                class="form-control"
                                id="jobDescription"
                                name="jobDescription"
                                rows="3"
                              >
<%= formData.jobDescription.trim() %></textarea
                              >
                            </div>
                            <div class="form-group mb-1">
                              <label for="managerSupervisor" class="input-label"
                                >Manager/Supervisor</label
                              >
                              <small class="form-text text-muted">
                                Name and EXACT title of the one person to whom
                                you directly report; Who is responsible for your
                                formal performance reviews?
                              </small>
                              <input
                                type="text"
                                class="form-control"
                                id="managerSupervisor"
                                name="managerSupervisor"
                                placeholder="Enter manager/supervisor"
                                value="<%= formData.managerSupervisor %>"
                              />
                            </div>
                            <div class="form-group mb-5 pb-5">
                              <label for="directReports" class="input-label"
                                >Direct Reports</label
                              >
                              <small class="form-text text-muted">
                                The names and EXACT titles of those persons who
                                report directly to you; you are responsible for
                                their formal performance reviews.
                              </small>
                              <textarea
                                class="form-control"
                                id="directReports"
                                name="directReports"
                                rows="3"
                              >
<%= formData.directReports.trim() %></textarea
                              >
                            </div>

                            <div class="form-group mb-3">
                              <label for="accountable" class="input-label"
                                >Accountable</label
                              >
                              <small class="form-text text-muted">
                                Areas of focus for which YOU, and ONLY YOU, are
                                Accountable.
                              </small>
                              <textarea
                                class="form-control"
                                id="accountable"
                                name="accountable"
                                rows="3"
                              >
<%= formData.accountable.trim() %></textarea
                              >
                            </div>

                            <div class="form-group mb-4 pb-3">
                              <label for="participate" class="input-label"
                                >Participate</label
                              >
                              <small class="form-text text-muted">
                                Activities you have responsibility to
                                participate in but for which someone else has
                                the “A".
                              </small>
                              <textarea
                                class="form-control"
                                id="participate"
                                name="participate"
                                rows="3"
                              >
<%= formData.participate.trim() %></textarea
                              >
                            </div>

                            <!-- <div class="form-group mb-3">
                            <label for="compensation" class="input-label">Compensation</label>
                            <small class="form-text text-muted">
                              How are you compensated, other than salary (types and structure of compensation, not amounts: e.g., commissions, bonuses, gain-sharing, ownership interest)?
                            </small>
                            <textarea class="form-control" id="compensation" name="compensation" rows="3"><%= formData?.compensation ? formData?.compensation.trim() : "" %></textarea>
                            
                          </div> -->

                            <div class="form-group">
                              <label for="metrics" class="input-label"
                                >Metrics</label
                              >
                              <small class="form-text text-muted">
                                How does your direct supervisor measure your
                                success?
                              </small>
                              <textarea
                                class="form-control"
                                id="metrics"
                                name="metrics"
                                rows="3"
                              >
<%= formData.metrics.trim() %></textarea
                              >
                            </div>

                            <div class="form-group">
                              <label
                                for="positionalObjectives"
                                class="input-label"
                                >Current Year Positional Objectives</label
                              >
                              <small class="form-text text-muted">
                                What are your key objectives for this fiscal
                                year in your current position? These are likely
                                objectives that are currently in written form.
                              </small>
                              <textarea
                                class="form-control"
                                id="positionalObjectives"
                                name="positionalObjectives"
                                rows="3"
                              >
<%= formData.positionalObjectives.trim() %></textarea
                              >
                            </div>

                            <div class="form-group">
                              <label
                                for="personalObjectives"
                                class="input-label"
                                >Personal Objectives</label
                              >
                              <small class="form-text text-muted">
                                What are your personal (not positional)
                                objectives over the next 2-3 years and beyond?
                              </small>
                              <textarea
                                class="form-control"
                                id="personalObjectives"
                                name="personalObjectives"
                                rows="3"
                              >
<%= formData.personalObjectives.trim() %></textarea
                              >
                            </div>

                            <div class="form-group">
                              <label for="authorityLevels" class="input-label"
                                >Authority Levels</label
                              >
                              <small class="form-text text-muted">
                                What authority levels or decision rights do you
                                have for planning, spending, hiring/firing,
                                contractual relationships, structural changes,
                                etc.?
                              </small>
                              <textarea
                                class="form-control"
                                id="authorityLevels"
                                name="authorityLevels"
                                rows="3"
                              >
<%= formData.authorityLevels.trim() %></textarea
                              >
                            </div>

                            <div class="form-group">
                              <label
                                for="delegationOfAuthority"
                                class="input-label"
                                >Delegation of Authority</label
                              >
                              <small class="form-text text-muted">
                                What freedom do you give to your subordinates to
                                make decisions on their own, e.g. authority
                                levels, requesting permission, submitting data,
                                etc. Think about which of your accountabilities
                                you might be able to delegate.
                              </small>
                              <textarea
                                class="form-control"
                                id="delegationOfAuthority"
                                name="delegationOfAuthority"
                                rows="3"
                              >
<%= formData.delegationOfAuthority.trim() %></textarea
                              >
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
