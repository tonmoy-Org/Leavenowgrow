  <body style="background-color: #4287f5">
    <div class="wrapper">
      <!-- toast telling the email successfully delivered  -->
      <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div
          id="successToast"
          class="toast text-bg-success"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
        >
          <div class="d-flex align-items-center justify-content-around">
            <div class="toast-body">Your message delivered successfully.</div>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="toast"
              aria-label="Close"
            ></button>
          </div>
        </div>
      </div>

      <!-- error modal if error occured  -->
      <div
        class="modal"
        style="z-index: 9999"
        id="errorModal"
        tabindex="-1"
        aria-labelledby="exampleModalLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="exampleModalLabel">Error Message</h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body">
              <h6 class="error"></h6>
            </div>
            <div class="modal-footer">
              <button class="btn btn-secondary" data-bs-dismiss="modal">
                Okay
              </button>
            </div>
          </div>
        </div>
      </div>

