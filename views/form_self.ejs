    <script>
      // pause the video when click on close button
      function pauseVideo(videoId) {
        const video = document.getElementById(videoId);

        if (video.play) {
          video.pause();
        }
      }

      // loader while sending email
      function showLoading(state) {
        const submitBtn = document.getElementById("submitBtn");
        const loader = document.getElementById("loader");
        if (state === true) {
          loader.style.display = "block";
          submitBtn.disabled = true;
        } else {
          loader.style.display = "none";
          submitBtn.disabled = false;
        }
      }

      // send email to the address
      function sendEmail(event) {
        event.preventDefault();
        const form = event.target;

        const data = {
          email: form.email.value,
          adminEmail: form.adminEmail.value,
          compId: form.compId.value,
          groupId: form.groupId.value,
          subject: form.subject.value,
          content: form.emailContent.value,
        };

        const jsonData = JSON.stringify(data);

        // Send a POST request to /send-aoa-link
        showLoading(true);
        fetch("/send-aoa-link", {
          method: "POST",
          body: jsonData,
          mode: "cors",
          cache: "no-cache",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response was not ok");
            }
            // You can parse the response if needed
            showLoading(false);
            // success toast open
            const toastSuccess = document.getElementById("successToast");
            const toastBootstrap =
              bootstrap.Toast.getOrCreateInstance(toastSuccess);
            toastBootstrap.show();
          })
          .then((data) => {
            // Handle the response data here (if needed)
            console.log(new Date(), "Response data:", data);
          })
          .catch((error) => {
            showLoading(false);
            console.error("Error sending revision data:", error);
            const errorElement = document.querySelector(".error");
            errorElement.innerText = "ERROR!!   :" + error;
            const modal = document.getElementById("errorModal");
            const bootstrapModal = new bootstrap.Modal(modal);
            bootstrapModal.show();
          });
      }
    </script>
