<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link
      rel="canonical"
      href="https://demo-basic.adminkit.io/pages-sign-in.html"
    />

    <title>Change My Password | Assignment of Accountability Tool</title>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link href="/css/app.css" rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
      integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>

  <body>
    <main class="d-flex w-100">
      <div class="container d-flex flex-column">
        <div class="row vh-100">
          <div
            class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto d-table h-100"
          >
            <div class="d-table-cell align-middle">
              <div class="text-center mt-4">
                <h1 class="h2">Assignment of Accountability Tool</h1>
                <p class="lead">Please change your password</p>
              </div>

              <div class="card">
                <div class="card-body">
                  <div class="m-sm-3">
                    <form
                      class="needs-validation"
                      novalidate
                      onsubmit="handleChangePassword(event)"
                    >
                      <input
                        class="hidden"
                        type="email"
                        name="email"
                        value="<%= email %>"
                        hidden
                      />
                      <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <div class="input-group" id="show_hide_password">
                          <input
                            id="validationPassword"
                            class="form-control form-control-lg"
                            type="password"
                            name="password"
                            placeholder="Type new password"
                            required
                          />
                          <button
                            id="show_hide_password_btn"
                            class="btn btn-secondary"
                            type="button"
                            id="button-addon2"
                            onclick="handleShowHidePassword()"
                          >
                            <i
                              id="show_hide_password_icon"
                              class="fa fa-eye"
                              aria-hidden="true"
                            ></i>
                          </button>
                        </div>
                        <div class="progress" style="height: 5px">
                          <div
                            id="progressbar"
                            class="progress-bar progress-bar-striped progress-bar-animated"
                            role="progressbar"
                            style="width: 10%"
                            aria-valuenow="50"
                            aria-valuemin="0"
                            aria-valuemax="100"
                          ></div>
                        </div>
                        <small
                          id="passwordHelpBlock"
                          class="form-text text-muted"
                        >
                          Use 8-20 characters, including a number, a special
                          character (!@#$%&*_?), and upper & lowercase letters.
                        </small>

                        <div id="feedbackin" class="valid-feedback">
                          Strong Password!
                        </div>
                        <div id="feedbackirn" class="invalid-feedback">
                          Atlead 8 characters, Number, special character
                          Caplital Letter and Small letters
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Re-type New Password</label>
                        <div class="input-group" id="show_hide_password">
                          <input
                            id="validationRetypePassword"
                            class="form-control form-control-lg"
                            type="password"
                            name="confirmPassword"
                            placeholder="Confirm the password"
                            disabled
                            required
                          />
                          <button
                            id="show_hide_retype_password_btn"
                            class="btn btn-secondary"
                            type="button"
                            id="button-addon2"
                            onclick="handleShowHideRetypePassword()"
                          >
                            <i
                              id="show_hide_retype_password_icon"
                              class="fa fa-eye"
                              aria-hidden="true"
                            ></i>
                          </button>
                        </div>
                        <div id="feedbackretypein" class="valid-feedback">
                          Password Matched!
                        </div>
                        <div id="feedbackretypeirn" class="invalid-feedback">
                          Password did not Match!
                        </div>
                      </div>

                      <div class="d-grid gap-2 mt-3">
                        <button id="submitBtn" type="submit" class="btn btn-lg btn-primary">
                          Submit New Password
                          <span
                            id="loader"
                            style="display: none"
                            class="spinner-border spinner-border-sm"
                          ></span>
                        </button>
                      </div>
                    </form>
                    <div
                      id="toast-container"
                      style="display: none"
                      class="toast-container position-fixed bottom-0 end-0 p-3"
                    >
                      <div
                        class="toast"
                        role="alert"
                        aria-live="assertive"
                        aria-atomic="true"
                      >
                        <div class="toast-body">
                          <div
                            class="p-2 text-white rounded-2 bg-primary d-flex align-items-center gap-2"
                          >
                            <p class="m-0" id="toast-message">
                              Hello, world! This is a toast message.
                            </p>
                            <button
                              type="button"
                              class="btn-close btn-close-white"
                              data-bs-dismiss="toast"
                              aria-label="Close"
                            ></button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div
                class="text-center mb-3 d-flex align-items-center justify-content-center gap-4"
              >
                <!-- <a href="/register">Sign Up</a> -->
                <a href="/login">Log In</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="/js/app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>

    <script>
      function handleShowHidePassword() {
        const inputElem = document.getElementById("validationPassword");
        const btnElem = document.getElementById("show_hide_password_btn");

        const inputType = inputElem.getAttribute("type");

        if (inputType === "password") {
          inputElem.setAttribute("type", "text");
          btnElem.innerHTML =
            '<i class="fa fa-eye-slash" aria-hidden="true"></i>';
        } else if (inputType === "text") {
          inputElem.setAttribute("type", "password");
          btnElem.innerHTML = '<i class="fa fa-eye" aria-hidden="true"></i>';
        }
      }

      function handleShowHideRetypePassword() {
        const inputElem = document.getElementById("validationRetypePassword");
        const btnElem = document.getElementById(
          "show_hide_retype_password_btn"
        );

        const inputType = inputElem.getAttribute("type");

        if (inputType === "password") {
          inputElem.setAttribute("type", "text");
          btnElem.innerHTML =
            '<i class="fa fa-eye-slash" aria-hidden="true"></i>';
        } else if (inputType === "text") {
          inputElem.setAttribute("type", "password");
          btnElem.innerHTML = '<i class="fa fa-eye" aria-hidden="true"></i>';
        }
      }
    </script>

    <script>
      (function () {
        "use strict";
        window.addEventListener(
          "load",
          function () {
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.getElementsByClassName("needs-validation");
            // Loop over them and prevent submission
            var validation = Array.prototype.filter.call(
              forms,
              function (form) {
                // making sure password enters the right characters
                form.validationPassword.addEventListener(
                  "keypress",
                  function (event) {
                    var checkx = true;
                    var chr = String.fromCharCode(event.which);

                    var matchedCase = new Array();
                    matchedCase.push("[!@#$%&*_?]"); // Special Charector
                    matchedCase.push("[A-Z]"); // Uppercase Alpabates
                    matchedCase.push("[0-9]"); // Numbers
                    matchedCase.push("[a-z]");

                    for (var i = 0; i < matchedCase.length; i++) {
                      if (new RegExp(matchedCase[i]).test(chr)) {
                        checkx = false;
                      }
                    }

                    if (form.validationPassword.value.length >= 20)
                      checkx = true;

                    if (checkx) {
                      event.preventDefault();
                      event.stopPropagation();
                    }
                  }
                );

                //Validate Password to have more than 8 Characters and A capital Letter, small letter, number and special character
                // Create an array and push all possible values that you want in password
                var matchedCase = new Array();
                matchedCase.push("[$@$$!%*#?&]"); // Special Charector
                matchedCase.push("[A-Z]"); // Uppercase Alpabates
                matchedCase.push("[0-9]"); // Numbers
                matchedCase.push("[a-z]"); // Lowercase Alphabates

                form.validationPassword.addEventListener("keyup", function () {
                  var messageCase = new Array();
                  messageCase.push(" Special Charector"); // Special Charector
                  messageCase.push(" Upper Case"); // Uppercase Alpabates
                  messageCase.push(" Numbers"); // Numbers
                  messageCase.push(" Lower Case"); // Lowercase Alphabates

                  var ctr = 0;
                  var rti = "";
                  for (var i = 0; i < matchedCase.length; i++) {
                    if (
                      new RegExp(matchedCase[i]).test(
                        form.validationPassword.value
                      )
                    ) {
                      if (i == 0)
                        messageCase.splice(
                          messageCase.indexOf(" Special Charector"),
                          1
                        );
                      if (i == 1)
                        messageCase.splice(
                          messageCase.indexOf(" Upper Case"),
                          1
                        );
                      if (i == 2)
                        messageCase.splice(messageCase.indexOf(" Numbers"), 1);
                      if (i == 3)
                        messageCase.splice(
                          messageCase.indexOf(" Lower Case"),
                          1
                        );
                      ctr++;
                    }
                  }

                  // Display it
                  var progressbar = 0;
                  var strength = "";
                  var bClass = "";
                  switch (ctr) {
                    case 0:
                    case 1:
                      strength = "Way too Weak";
                      progressbar = 15;
                      bClass = "bg-danger";
                      break;
                    case 2:
                      strength = "Very Weak";
                      progressbar = 25;
                      bClass = "bg-danger";
                      break;
                    case 3:
                      strength = "Weak";
                      progressbar = 34;
                      bClass = "bg-warning";
                      break;
                    case 4:
                      strength = "Medium";
                      progressbar = 65;
                      bClass = "bg-warning";
                      break;
                  }

                  if (
                    strength == "Medium" &&
                    form.validationPassword.value.length >= 8
                  ) {
                    strength = "Strong";
                    bClass = "bg-success";
                    form.validationPassword.setCustomValidity("");
                  } else {
                    form.validationPassword.setCustomValidity(strength);
                  }

                  var sometext = "";

                  if (form.validationPassword.value.length < 8) {
                    var lengthI = 8 - form.validationPassword.value.length;
                    sometext += ` ${lengthI} more Characters, `;
                  }

                  sometext += messageCase;

                  if (sometext) {
                    sometext = " You Need" + sometext;
                  }

                  $("#progressbar")
                    .removeClass("bg-danger bg-warning bg-success")
                    .addClass(bClass);
                  var plength = form.validationPassword.value.length;
                  if (plength > 0) progressbar += (plength - 0) * 1.75;

                  var percentage = progressbar + "%";

                  $("#progressbar").width(percentage);

                  if (form.validationPassword.checkValidity() === true) {
                    form.validationRetypePassword.disabled = false;

                    $("#feedbackin").text(strength + sometext);
                    $("#feedbackin").css({
                      display: "block",
                    });
                    $("#feedbackirn").css({
                      display: "none",
                    });
                  } else {
                    form.validationRetypePassword.disabled = true;

                    $("#feedbackirn").text(strength + sometext);
                    $("#feedbackirn").css({
                      display: "block",
                    });
                    $("#feedbackin").css({
                      display: "none",
                    });
                  }
                });

                form.validationRetypePassword.addEventListener(
                  "keyup",
                  function () {
                    const newPassword = form.validationPassword.value;
                    const retypeNewPassword =
                      form.validationRetypePassword.value;

                    const validFeedbackElem =
                      document.getElementById("feedbackretypein");
                    const inValidFeedbackElem =
                      document.getElementById("feedbackretypeirn");

                    if (!(newPassword === retypeNewPassword)) {
                      // mismath password case
                      form.validationRetypePassword.classList.add("is-invalid");
                      validFeedbackElem.style.display = "none";
                      inValidFeedbackElem.style.display = "block";
                    } else {
                      // mathed case
                      form.validationRetypePassword.classList.remove(
                        "is-invalid"
                      );
                      form.validationRetypePassword.classList.add("is-valid");

                      validFeedbackElem.style.display = "block";
                      inValidFeedbackElem.style.display = "none";
                    }
                  }
                );
              }
            );
          },
          false
        );
      })();
    </script>

    <script>
      function isStrongPassword(password) {
        const strongPasswordRegExp =
          /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;
        return strongPasswordRegExp.test(password);
      }

      // loader while sending email
      function showLoading(state) {
        const submitBtn = document.getElementById("submitBtn");
        const loader = document.getElementById("loader");
        if (state === true) {
          loader.style.display = "block";
          submitBtn.disabled = true;
        } else {
          loader.style.display = "none";
          submitBtn.disabled = false;
        }
      }

      function showMessageToast(message) {
        const toastContainer = document.getElementById("toast-container");
        const toastMessageElem = document.getElementById("toast-message");

        toastContainer.style.display = "block";
        toastMessageElem.innerHTML = message;

        setTimeout(() => {
          toastContainer.style.display = "none";
        }, 5000);
      }

      function handleChangePassword(event) {
        event.preventDefault();
        const form = event.target;
        form.classList.add("was-validated");
        if (
          !form.email.value ||
          !form.password.value ||
          !form.confirmPassword.value
        ) {
          console.log("missing data...");
          return;
        }

        if (!form.email.value) {
          showMessageToast("Missing email.");
          return;
        } else if (!form.password.value) {
          showMessageToast("Missing password.");
          return;
        } else if (!form.confirmPassword.value) {
          showMessageToast("Missing repeat password.");
          return;
        }

        if (form.password.value !== form.confirmPassword.value) {
          showMessageToast("Password did not match.");
          return;
        }

        const formData = {
          email: form.email.value,
          password: form.password.value,
        };

        const jsonData = JSON.stringify(formData);

        fetch("/change-my-password", {
          method: "POST",
          body: jsonData,
          mode: "cors",
          cache: "no-cache",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
          },
        })
          .then((res) => {
            if (!res.ok) {
              throw new Error("Request failed due to server error.");
            }
            return res.json();
          })
          .then((data) => {
            form.reset();
            showMessageToast(data?.message);
            showLoading(false);

            setTimeout(() => {
              if (data?.status) {
                window.location.href = "/login";
              }
            }, 3000);
          })
          .catch((error) => {
            console.log("Registration Error: ", error);
            if (error?.message) {
              showMessageToast(error?.message);
            }
          });
      }
    </script>
  </body>
</html>
