    <script>
      window.addEventListener("DOMContentLoaded", async function () {
        const comId = `<%= company %>`;
        var savedColumnOrder = await fetchColumnOrder(comId);

        // localStorage.getItem("columnOrder");

        if (savedColumnOrder) {
          var columnOrder = savedColumnOrder;

          // Reorder the columns based on the saved order
          var table = document.getElementById("sortableTable");

          var headerRows = table.querySelectorAll("thead tr , tbody tr");

          for (var i = 0; i < columnOrder.length; i++) {
            var columnId = columnOrder[i];
            headerRows.forEach(function (row) {
              var headerCell = row.querySelector(
                "td[id='" + columnId + "'], th[id='" + columnId + "']"
              );
              if (headerCell) {
                row.appendChild(headerCell);
              }
            });
          }
        }
      });
    </script>

    <style>
      .rounded-button {
        width: 40px;
        height: 40px;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
      }

      .check-all {
        display: flex;
        left: 0;
        justify-content: flex-end;
        top: 0;
        height: 2rem;
        width: 100%;
        align-items: flex-start;
      }

      .check-all > label {
        font-size: 0.6rem;
        margin-left: 0.3rem;
      }

      .downloadOptions ul li {
        cursor: pointer;
      }

      .downloadOptions ul li:hover {
        color: #dc3545;
      }

      .table-responsive {
        height: calc(100vh - 200px);
      }
    </style>
