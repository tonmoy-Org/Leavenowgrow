<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta
      name="description"
      content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5"
    />
    <meta name="author" content="AdminKit" />
    <meta
      name="keywords"
      content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web"
    />

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="shortcut icon" href="/img/photos/symbol.png" />

    <link
      rel="canonical"
      href="https://demo-basic.adminkit.io/pages-sign-in.html"
    />

    <title>Register | Assignment of Accountability Tool</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link href="/css/app.css" rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
      integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <style>
    .bg-brand {
      background: rgba(50, 106, 188, 10);
      background: radial-gradient(
        circle,
        rgba(50, 106, 188, 0.25) 0%,
        rgba(255, 255, 255, 1) 100%
      );
    }
    .custom-shadow {
      box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
    }

    .obj {
      border-radius: 50%;
      width: 95%;
      height: 95%;
      object-fit: cover;
    }
  </style>
  <body class="bg-brand">
    <main class="d-flex w-100">
      <div class="container d-flex flex-column">
        <div class="row vh-100">
          <div
            class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto d-table h-100"
          >
            <div class="d-table-cell align-middle">
              <div class="text-center mt-4">
                <img
                  src="/img/photos/symbol.png"
                  alt="logo"
                  style="width: 50px; margin-bottom: 4px"
                />
                <h1 class="h2">Create New Account</h1>

                <!-- <p class="lead">
                  Register to access all amazing features of our AOA system
                </p> -->

                <div class="text-center mb-3">
                  Already registered? <a href="/login">Log in here.</a>
                </div>
              </div>

              <div class="card custom-shadow">
                <div class="card-body">
                  <div class="m-sm-3">
                    <% if (message && message?.length > 0) { %>
                    <div
                      class="col-md-12"
                      style="background-color: #f8d7da; padding: 20px"
                    >
                      <%= message %>
                    </div>
                    <% } %>
                    <form
                      class="needs-validation"
                      onsubmit="handleRegistrationSubmit(event)"
                      novalidate
                    >
                      <div class="mb-3">
                        <div
                          class="d-flex flex-column align-items-center justify-content-center text-center"
                        >
                          <div
                            id="preview"
                            style="width: 128px; height: 128px"
                            class="d-flex align-items-center justify-content-center p-2 align-middle rounded-circle"
                          >
                            <i
                              class="align-middle"
                              data-feather="user"
                              style="width: 80%; height: 80%"
                            ></i>
                          </div>

                          <div class="mt-2">
                            <button
                              type="button"
                              onclick="handleFile()"
                              class="btn btn-primary"
                            >
                              <i class="fas fa-upload"></i> Upload
                            </button>
                          </div>
                          <input
                            type="file"
                            name="file"
                            id="fileInput"
                            class="d-none"
                            accept="image/*"
                          />
                          <small class="mt-2">
                            Recommend size: JPG, 128&times;128px or larger
                          </small>
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">First and Last Name</label>
                        <input
                          class="form-control form-control-lg"
                          type="text"
                          name="name"
                          placeholder="Enter your name"
                          required
                        />
                        <div class="invalid-feedback">
                          Please type your name.
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input
                          id="email-input"
                          class="form-control form-control-lg"
                          type="email"
                          name="email"
                          placeholder="Enter your email"
                          value="<%= email ?? '' %>"
                          required
                        />
                        <div class="invalid-feedback">
                          Please type a valid email.
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Password</label>
                        <div class="input-group" id="show_hide_password">
                          <input
                            id="validationPassword"
                            class="form-control form-control-lg"
                            type="password"
                            name="password"
                            placeholder="Type new password"
                            required
                          />
                          <button
                            id="show_hide_password_btn"
                            class="btn btn-secondary"
                            type="button"
                            id="button-addon2"
                            onclick="handleShowHidePassword()"
                          >
                            <i
                              id="show_hide_password_icon"
                              class="fa fa-eye"
                              aria-hidden="true"
                            ></i>
                          </button>
                        </div>
                        <div class="progress" style="height: 5px">
                          <div
                            id="progressbar"
                            class="progress-bar progress-bar-striped progress-bar-animated"
                            role="progressbar"
                            style="width: 10%"
                            aria-valuenow="50"
                            aria-valuemin="0"
                            aria-valuemax="100"
                          ></div>
                        </div>
                        <small
                          id="passwordHelpBlock"
                          class="form-text text-muted"
                        >
                          Use 8-20 characters, including a number, a special
                          character (!@#$%&*_?), and upper & lowercase letters.
                        </small>

                        <div id="feedbackin" class="valid-feedback">
                          Strong Password!
                        </div>
                        <div id="feedbackirn" class="invalid-feedback">
                          Atlead 8 characters, Number, special character
                          Caplital Letter and Small letters
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Re-type Password</label>
                        <div class="input-group" id="show_hide_password">
                          <input
                            id="validationRetypePassword"
                            class="form-control form-control-lg"
                            type="password"
                            name="confirmPassword"
                            placeholder="Confirm the password"
                            disabled
                            required
                          />
                          <button
                            id="show_hide_retype_password_btn"
                            class="btn btn-secondary"
                            type="button"
                            id="button-addon2"
                            onclick="handleShowHideRetypePassword()"
                          >
                            <i
                              id="show_hide_retype_password_icon"
                              class="fa fa-eye"
                              aria-hidden="true"
                            ></i>
                          </button>
                        </div>
                        <div id="feedbackretypein" class="valid-feedback">
                          Password Matched!
                        </div>
                        <div id="feedbackretypeirn" class="invalid-feedback">
                          Password did not Match!
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Company</label>
                        <select
                          class="form-select"
                          name="company"
                          id="select-company-updated"
                          required
                        >
                          <option
                            id="<%= company?._id %>"
                            value="<%= company?._id %>"
                            selected
                          >
                            <%= company?.name %>
                          </option>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Manager Name</label>
                        <select
                          class="form-select"
                          name="manager"
                          id="select-manager-updated"
                          required
                        >
                          <option
                            id="<%= manager?._id %>"
                            value="<%= manager?._id %>:<%= manager?.name %>:<%= manager?.email %>:<%= manager?.level %>"
                            selected
                          >
                            <%= manager?.name %>
                          </option>
                        </select>
                      </div>
                      <div class="d-grid gap-2 mt-3">
                        <button
                          type="submit"
                          id="submitBtn"
                          class="btn btn-lg btn-primary"
                        >
                          Sign up
                          <span
                            id="loader"
                            style="display: none"
                            class="spinner-border spinner-border-sm"
                          ></span>
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        id="toast-container"
        style="display: none"
        class="toast-container position-fixed bottom-0 end-0 p-3"
      >
        <div
          class="toast"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
        >
          <div class="toast-body">
            <div
              class="p-2 text-white rounded-2 bg-primary d-flex align-items-center gap-2"
            >
              <p class="m-0" id="toast-message">
                Hello, world! This is a toast message.
              </p>
              <button
                type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="toast"
                aria-label="Close"
              ></button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="js/app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>

    <script>
      // loader while sending email
      function showLoading(state) {
        const submitBtn = document.getElementById("submitBtn");
        const loader = document.getElementById("loader");
        if (state === true) {
          loader.style.display = "block";
          submitBtn.disabled = true;
        } else {
          loader.style.display = "none";
          submitBtn.disabled = false;
        }
      }
    </script>
    <script>
      const selectedCompany = "<%= company %>";

      fetch("/companies/all")
        .then((res) => res.json())
        .then((data) => {
          const companies = data?.companies;

          const selectElem = document.getElementById("select-company");

          const optionElements = [];

          const defaultoption = document.createElement("option");
          defaultoption.innerText = "Choose Company";
          defaultoption.classList.add("disabled");
          optionElements.push(defaultoption);

          // Create HTML markup for the employee list
          companies.forEach((company) => {
            // const option = document.createElement("option");
            // option.innerText = company.name;
            // option.value = `${company?._id}`;

            if (
              selectedCompany &&
              selectedCompany === (company?._id).toString()
            ) {
              const option = document.createElement("option");
              option.innerText = company.name;
              option.value = `${company?._id}`;
              option.selected = true;
              option.setAttribute("id", company._id);
              optionElements.push(option);

              selectElem.disabled = true;
            }

            // option.setAttribute("id", company._id);

            // optionElements.push(option);
          });

          optionElements.forEach((option) => {
            selectElem.appendChild(option);
          });
        });
    </script>

    <script>
      const selectedManager = "<%= manager %>";

      function getManagers(companyId) {
        const selectElem = document.getElementById("select-manager");
        selectElem.innerHTML = "";

        if (!companyId) {
          return;
        }

        let managersData = [];

        fetch(`/managers/${companyId}`)
          .then((res) => res.json())
          .then((data) => {
            const managers = data?.parentUsers;

            const optionElements = [];

            const defaultoption = document.createElement("option");
            defaultoption.innerText = "Choose Manager";
            defaultoption.value = "";
            defaultoption.classList.add("disabled");
            optionElements.push(defaultoption);

            // Create HTML markup for the employee list
            managers.forEach((manager) => {
              // const option = document.createElement("option");
              // option.innerText = manager.name;
              // option.value = `${manager?._id}:${manager?.name}:${manager?.email}:${manager?.level}`;

              if (
                selectedManager &&
                selectedManager === (manager?._id).toString()
              ) {
                const option = document.createElement("option");
                option.innerText = manager.name;
                option.value = `${manager?._id}:${manager?.name}:${manager?.email}:${manager?.level}`;

                option.setAttribute("selected", true);
                selectElem.setAttribute("disabled", true);

                option.setAttribute("id", manager._id);

                optionElements.push(option);

                managersData.push(manager);
              }

              // option.setAttribute("id", manager._id);

              // optionElements.push(option);

              // managersData.push(manager);
            });

            optionElements.forEach((option) => {
              selectElem.appendChild(option);
            });
          });

        return managersData;
      }

      function handleSelectCompany(event) {
        const companyId = event.target.value;

        getManagers(companyId);
      }
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const selectManager = document.getElementById("select-manager");
        const managers = getManagers(selectedCompany);
      });
    </script>
    <script>
      function handleShowHidePassword() {
        const inputElem = document.getElementById("validationPassword");
        const btnElem = document.getElementById("show_hide_password_btn");

        const inputType = inputElem.getAttribute("type");

        if (inputType === "password") {
          inputElem.setAttribute("type", "text");
          btnElem.innerHTML =
            '<i class="fa fa-eye-slash" aria-hidden="true"></i>';
        } else if (inputType === "text") {
          inputElem.setAttribute("type", "password");
          btnElem.innerHTML = '<i class="fa fa-eye" aria-hidden="true"></i>';
        }
      }

      function handleShowHideRetypePassword() {
        const inputElem = document.getElementById("validationRetypePassword");
        const btnElem = document.getElementById(
          "show_hide_retype_password_btn"
        );

        const inputType = inputElem.getAttribute("type");

        if (inputType === "password") {
          inputElem.setAttribute("type", "text");
          btnElem.innerHTML =
            '<i class="fa fa-eye-slash" aria-hidden="true"></i>';
        } else if (inputType === "text") {
          inputElem.setAttribute("type", "password");
          btnElem.innerHTML = '<i class="fa fa-eye" aria-hidden="true"></i>';
        }
      }
    </script>
    <script>
      (function () {
        "use strict";
        window.addEventListener(
          "load",
          function () {
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.getElementsByClassName("needs-validation");
            // Loop over them and prevent submission
            var validation = Array.prototype.filter.call(
              forms,
              function (form) {
                // making sure password enters the right characters
                form.validationPassword.addEventListener(
                  "keypress",
                  function (event) {
                    var checkx = true;
                    var chr = String.fromCharCode(event.which);

                    var matchedCase = new Array();
                    matchedCase.push("[!@#$%&*_?]"); // Special Charector
                    matchedCase.push("[A-Z]"); // Uppercase Alpabates
                    matchedCase.push("[0-9]"); // Numbers
                    matchedCase.push("[a-z]");

                    for (var i = 0; i < matchedCase.length; i++) {
                      if (new RegExp(matchedCase[i]).test(chr)) {
                        checkx = false;
                      }
                    }

                    if (form.validationPassword.value.length >= 20)
                      checkx = true;

                    if (checkx) {
                      event.preventDefault();
                      event.stopPropagation();
                    }
                  }
                );

                //Validate Password to have more than 8 Characters and A capital Letter, small letter, number and special character
                // Create an array and push all possible values that you want in password
                var matchedCase = new Array();
                matchedCase.push("[$@$$!%*#?&]"); // Special Charector
                matchedCase.push("[A-Z]"); // Uppercase Alpabates
                matchedCase.push("[0-9]"); // Numbers
                matchedCase.push("[a-z]"); // Lowercase Alphabates

                form.validationPassword.addEventListener("keyup", function () {
                  var messageCase = new Array();
                  messageCase.push(" Special Charector"); // Special Charector
                  messageCase.push(" Upper Case"); // Uppercase Alpabates
                  messageCase.push(" Numbers"); // Numbers
                  messageCase.push(" Lower Case"); // Lowercase Alphabates

                  var ctr = 0;
                  var rti = "";
                  for (var i = 0; i < matchedCase.length; i++) {
                    if (
                      new RegExp(matchedCase[i]).test(
                        form.validationPassword.value
                      )
                    ) {
                      if (i == 0)
                        messageCase.splice(
                          messageCase.indexOf(" Special Charector"),
                          1
                        );
                      if (i == 1)
                        messageCase.splice(
                          messageCase.indexOf(" Upper Case"),
                          1
                        );
                      if (i == 2)
                        messageCase.splice(messageCase.indexOf(" Numbers"), 1);
                      if (i == 3)
                        messageCase.splice(
                          messageCase.indexOf(" Lower Case"),
                          1
                        );
                      ctr++;
                    }
                  }

                  // Display it
                  var progressbar = 0;
                  var strength = "";
                  var bClass = "";
                  switch (ctr) {
                    case 0:
                    case 1:
                      strength = "Way too Weak";
                      progressbar = 15;
                      bClass = "bg-danger";
                      break;
                    case 2:
                      strength = "Very Weak";
                      progressbar = 25;
                      bClass = "bg-danger";
                      break;
                    case 3:
                      strength = "Weak";
                      progressbar = 34;
                      bClass = "bg-warning";
                      break;
                    case 4:
                      strength = "Medium";
                      progressbar = 65;
                      bClass = "bg-warning";
                      break;
                  }

                  if (
                    strength == "Medium" &&
                    form.validationPassword.value.length >= 8
                  ) {
                    strength = "Strong";
                    bClass = "bg-success";
                    form.validationPassword.setCustomValidity("");
                  } else {
                    form.validationPassword.setCustomValidity(strength);
                  }

                  var sometext = "";

                  if (form.validationPassword.value.length < 8) {
                    var lengthI = 8 - form.validationPassword.value.length;
                    sometext += ` ${lengthI} more Characters, `;
                  }

                  sometext += messageCase;

                  if (sometext) {
                    sometext = " You Need" + sometext;
                  }

                  $("#progressbar")
                    .removeClass("bg-danger bg-warning bg-success")
                    .addClass(bClass);
                  var plength = form.validationPassword.value.length;
                  if (plength > 0) progressbar += (plength - 0) * 1.75;

                  var percentage = progressbar + "%";

                  $("#progressbar").width(percentage);

                  if (form.validationPassword.checkValidity() === true) {
                    form.validationRetypePassword.disabled = false;

                    $("#feedbackin").text(strength + sometext);
                    $("#feedbackin").css({
                      display: "block",
                    });
                    $("#feedbackirn").css({
                      display: "none",
                    });
                  } else {
                    form.validationRetypePassword.disabled = true;

                    $("#feedbackirn").text(strength + sometext);
                    $("#feedbackirn").css({
                      display: "block",
                    });
                    $("#feedbackin").css({
                      display: "none",
                    });
                  }
                });

                form.validationRetypePassword.addEventListener(
                  "keyup",
                  function () {
                    const newPassword = form.validationPassword.value;
                    const retypeNewPassword =
                      form.validationRetypePassword.value;

                    const validFeedbackElem =
                      document.getElementById("feedbackretypein");
                    const inValidFeedbackElem =
                      document.getElementById("feedbackretypeirn");

                    if (!(newPassword === retypeNewPassword)) {
                      // mismath password case
                      form.validationRetypePassword.classList.add("is-invalid");
                      validFeedbackElem.style.display = "none";
                      inValidFeedbackElem.style.display = "block";
                    } else {
                      // mathed case
                      form.validationRetypePassword.classList.remove(
                        "is-invalid"
                      );
                      form.validationRetypePassword.classList.add("is-valid");

                      validFeedbackElem.style.display = "block";
                      inValidFeedbackElem.style.display = "none";
                    }
                  }
                );
              }
            );
          },
          false
        );
      })();
    </script>
    <script>
      const inputFileElem = document.getElementById("fileInput");
      inputFileElem.addEventListener(
        "change",
        function () {
          const images = this.files;

          handleImages(images);
        },
        false
      );

      function handleFile() {
        inputFileElem.click();
      }

      function handleImages(images) {
        for (const image of images) {
          if (!image.type.startsWith("image/")) {
            continue;
          }

          const preview = document.getElementById("preview");

          const img = document.createElement("img");
          img.classList.add("obj");
          img.file = image;
          preview.innerHTML = "";
          preview.appendChild(img);

          const reader = new FileReader();
          reader.onload = (e) => {
            img.src = e.target.result;
          };
          reader.readAsDataURL(image);
        }
      }
    </script>
    <script>
      function showMessageToast(message) {
        const toastContainer = document.getElementById("toast-container");
        const toastMessageElem = document.getElementById("toast-message");

        toastContainer.style.display = "block";
        toastMessageElem.innerHTML = message;

        setTimeout(() => {
          toastContainer.style.display = "none";
        }, 5000);
      }

      function handleRegistrationSubmit(event) {
        event.preventDefault();
        const form = event.target;

        form.classList.add("was-validated");

        if (!form.name.value) {
          showMessageToast("Missing name.");
          return;
        } else if (!form.email.value) {
          showMessageToast("Missing email.");
          return;
        } else if (!form.password.value) {
          showMessageToast("Missing password.");
          return;
        } else if (!form.company.value) {
          showMessageToast("Missing company.");
          return;
        } else if (!form.manager.value) {
          showMessageToast("Missing manager.");
          return;
        }

        if (form.password.value !== form.confirmPassword.value) {
          showMessageToast("Password did not match.");
          return;
        }

        // file be a File Object = {name, lastModified, size, type, }
        const profilePictureFile = form.file.files.item(0);

        const data = {
          name: form.name.value,
          email: form.email.value,
          password: form.password.value,
          company: form.company.value,
          manager: form.manager.value,
        };

        const formData = new FormData();

        formData.append("data", JSON.stringify(data));
        formData.append("user", profilePictureFile);

        showLoading(true);
        fetch("/register", { method: "POST", body: formData })
          .then((res) => {
            if (!res.ok) {
              throw new Error("Request failed due to server error.");
            }
            return res.json();
          })
          .then((data) => {
            showMessageToast(data?.message);
            showLoading(false);

            setTimeout(() => {
              if (data?.status) {
                window.location.href = "/login";
              }
            }, 3000);
          })
          .catch((error) => {
            console.log("Registration Error: ", error);
            if (error?.message) {
              showMessageToast(error?.message);
            }
          });
      }
    </script>
  </body>
</html>
